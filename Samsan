local lastAddRequestAt = 0

local function addNewRoutePoint()
    local now = os.clock()
    if addPointBusy or (now - lastAddRequestAt) < 0.45 then return end
    lastAddRequestAt = now
    addPointBusy = true

    local ok, err = xpcall(function()
        if state.routeFarm then
            error("Сначала выключи автофарм")
        end
        local pos = parseXYZ(addCoordBox.Text)
        if not pos then error("Координаты в формате X, Y, Z") end

        local seconds = tonumber(tostring(addWaitBox.Text):gsub(",", ".")) or 2
        seconds = math.clamp(seconds, 0.05, 120)

        local name = tostring(addNameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Локация " .. tostring(#routePoints + 1) end

        local chestIndex = findChestIndex()
        local insertIndex = chestIndex or (#routePoints + 1)

        local newPoint = {
            name = name,
            pos = Vector3.new(pos.X, pos.Y, pos.Z),
            wait = seconds,
            isChest = false,
        }
        table.insert(routePoints, insertIndex, newPoint)
        rebuildRouteRows()

        setFarmStatus(string.format(
            "ДОБАВЛЕНО ✓ #%d %s // всего %d",
            insertIndex, name, #routePoints))

        addPointBtn.Text = "ДОБАВЛЕНО ✓ // #" .. tostring(insertIndex)

        task.delay(0.8, function()
            if addPointBtn and addPointBtn.Parent then
                addPointBtn.Text = "+ ДОБАВИТЬ ЛОКАЦИЮ В МАРШРУТ"
            end
            if addNameBox and addNameBox.Parent then addNameBox.Text = "" end
            if addCoordBox and addCoordBox.Parent then addCoordBox.Text = "" end
        end)
    end, function(message) return tostring(message) end)

    addPointBusy = false

    if not ok then
        local message = tostring(err or "неизвестная ошибка"):gsub("\n.*", "")
        setFarmStatus("ОШИБКА // " .. message)
        addPointBtn.Text = "ОШИБКА"
        task.delay(1.0, function()
            if addPointBtn and addPointBtn.Parent then
                addPointBtn.Text = "+ ДОБАВИТЬ ЛОКАЦИЮ В МАРШРУТ"
            end
        end)
    end
end

