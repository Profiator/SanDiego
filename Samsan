local function coordinateStrings()
    local root = getRoot()

    if not root then
        return "X 0.00   Y 0.00   Z 0.00",
               "0.00, 0.00, 0.00"
    end

    local p = root.Position

    return string.format(
        "X %.2f   Y %.2f   Z %.2f",
        p.X,
        p.Y,
        p.Z
    ),
    string.format(
        "%.2f, %.2f, %.2f",
        p.X,
        p.Y,
        p.Z
    )
end

addConnection(copyBtn.MouseButton1Click:Connect(function()
    local _, raw = coordinateStrings()

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, raw)
    elseif type(toclipboard) == "function" then
        copied = pcall(toclipboard, raw)
