-- =========================================================
-- EXACT AUTO REBIRTH
-- Scanner confirmed:
--   ReplicatedStorage.Shared.Remotes.RequestRebirth
--   RequestRebirth:InvokeServer()
--
-- Progress source confirmed:
--   PlayerGui.ScreenGui.LeftSide.Container.MenuButtons.Rebirth.Progress
--   Text = "100%"
-- =========================================================

local function getRebirthProgressLabel()
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    if not screenGui then
        return nil
    end

    local leftSide = screenGui:FindFirstChild("LeftSide")
    local container = leftSide and leftSide:FindFirstChild("Container")
    local menuButtons = container and container:FindFirstChild("MenuButtons")
    local rebirth = menuButtons and menuButtons:FindFirstChild("Rebirth")
    local progress = rebirth and rebirth:FindFirstChild("Progress")

    if progress and progress:IsA("TextLabel") then
        return progress
    end

    return nil
end

local function parseProgressPercent(textValue)
    local numberText =
        tostring(textValue or "")
        :match("([%d%.]+)%s*%%")

    local value = tonumber(numberText)

    if not value then
        return nil
    end

    return value
end

local lastRebirthAttempt = 0
local rebirthBusy = false
local rebirthArmed = true
local rebirthSuccessCount = 0

local function callRequestRebirth()
    if rebirthBusy or not state.autoRebirth then
        return
    end

    if os.clock() - lastRebirthAttempt < 1.0 then
        return
    end

    rebirthBusy = true
    lastRebirthAttempt = os.clock()

    setAutoStatus(
        "100% // RequestRebirth:InvokeServer()..."
    )

    task.spawn(function()
        local ok, success, message = pcall(function()
            return RequestRebirth:InvokeServer()
        end)

        if not ok then
            setAutoStatus(
                "REBIRTH ERROR // " .. tostring(success)
            )
            rebirthBusy = false
            return
        end

        if success then
            rebirthSuccessCount += 1
            rebirthArmed = false

            setAutoStatus(
                "ПЕРЕРОЖДЕНИЕ ✓ // #" ..
                tostring(rebirthSuccessCount)
            )
        else
            setAutoStatus(
                "REBIRTH ОТКЛОНЁН // " ..
                tostring(message or "без сообщения")
            )
        end

        task.wait(0.60)
        rebirthBusy = false
    end)
end

task.spawn(function()
    while alive do
        if not state.autoRebirth then
            task.wait(0.40)
            continue
        end

        local progress = getRebirthProgressLabel()

        if not progress then
            setAutoStatus(
                state.antiAfk
                and "Progress не найден // Anti-AFK активен"
                or "Progress не найден"
            )

            task.wait(0.50)
            continue
        end

        local percent =
            parseProgressPercent(progress.Text)

        if not percent then
            setAutoStatus(
                "Progress: " ..
                tostring(progress.Text)
            )

            task.wait(0.35)
            continue
        end

        -- После успешного rebirth ждём, пока прогресс реально
        -- упадёт ниже 100%, чтобы не отправлять запрос повторно.
        if percent < 100 then
            rebirthArmed = true

            setAutoStatus(
                string.format(
                    "REBIRTH %d%% // ждём 100%%%s",
                    math.floor(percent),
                    state.antiAfk
                        and " // Anti-AFK"
                        or ""
                )
            )
        elseif rebirthArmed and not rebirthBusy then
            callRequestRebirth()
        else
            setAutoStatus(
                "100% // ждём сброс после перерождения"
            )
        end

        task.wait(0.15)
    end
end)

-- =========================================================
-- HARD ANTI-AFK
-- =========================================================

local antiAfkPulseCount = 0
local disabledIdleConnections = {}

local function disableIdleConnections()
    if type(getconnections) ~= "function" then
        return
    end

    local ok, list = pcall(
        getconnections,
        player.Idled
    )

    if not ok or type(list) ~= "table" then
        return
    end

    for _, conn in ipairs(list) do
        pcall(function()
            if type(conn.Disable) == "function"
                and type(conn.Enable) == "function"
                and not disabledIdleConnections[conn]
            then
                conn:Disable()
                disabledIdleConnections[conn] = true
            end
        end)
    end
end

restoreIdleConnections = function()
    for conn in pairs(disabledIdleConnections) do
        pcall(function()
            if type(conn.Enable) == "function" then
                conn:Enable()
            end
        end)

        disabledIdleConnections[conn] = nil
    end
end

local function antiAfkPulse()
    if not state.antiAfk then
        return
    end

    antiAfkPulseCount += 1

    -- 1) VirtualUser — классический keep-alive.
    pcall(function()
        VirtualUser:CaptureController()

        VirtualUser:Button2Down(
            Vector2.new(0, 0),
            camera and camera.CFrame or CFrame.new()
        )

        task.wait(0.04)

        VirtualUser:Button2Up(
            Vector2.new(0, 0),
            camera and camera.CFrame or CFrame.new()
        )
    end)

    -- 2) Минимальное движение мыши: создаёт реальный input pulse,
    -- но почти не мешает игре.
    pcall(function()
        local mouse = UserInputService:GetMouseLocation()

        VirtualInputManager:SendMouseMoveEvent(
            math.floor(mouse.X + 1),
            math.floor(mouse.Y),
            game
        )

        task.wait(0.03)

        VirtualInputManager:SendMouseMoveEvent(
            math.floor(mouse.X),
            math.floor(mouse.Y),
            game
        )
    end)

    -- 3) Tiny movement для игр с собственным AFK-контролем.
    -- Позиция возвращается обратно, поэтому игрок не уходит с места.
    local root = getRoot()

    if root and not state.fly then
        pcall(function()
            local original = root.CFrame

            root.CFrame =
                original *
                CFrame.new(0.025, 0, 0)

            task.wait(0.035)

            if root and root.Parent then
                root.CFrame = original
            end
        end)
    end

    disableIdleConnections()

    if state.autoRebirth then
        setAutoStatus(
            "AUTO REBIRTH + ANTI-AFK // pulse #" ..
            tostring(antiAfkPulseCount)
        )
    else
        setAutoStatus(
            "ANTI-AFK АКТИВЕН // pulse #" ..
            tostring(antiAfkPulseCount)
        )
    end
end

-- На сам Roblox Idled реагируем немедленно.
addConnection(player.Idled:Connect(function()
    if state.antiAfk then
        task.spawn(antiAfkPulse)
    end
end))

-- И дополнительно даём активность заранее,
-- не дожидаясь стандартного idle timeout.
task.spawn(function()
    while alive do
        if state.antiAfk then
            antiAfkPulse()
            task.wait(22)
        else
            task.wait(1)
        end
    end
end)

