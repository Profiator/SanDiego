local rarityAliases = {
    ["COMUNE"] = "COMMON",
    ["COMMON"] = "COMMON",

    ["NON COMUNE"] = "UNCOMMON",
    ["UNCOMMON"] = "UNCOMMON",

    ["RARO"] = "RARE",
    ["RARE"] = "RARE",

    ["EPICO"] = "EPIC",
    ["EPIC"] = "EPIC",

    ["LEGGENDARIO"] = "LEGENDARY",
    ["LEGENDARY"] = "LEGENDARY",

    ["MITICO"] = "MYTHIC",
    ["MYTHIC"] = "MYTHIC",

    ["SECRET"] = "SECRET",

    ["DIVINO"] = "DIVINE",
    ["DIVINE"] = "DIVINE",

    ["LIMITED"] = "LIMITED",
}

local function canonicalRarity(value)
    local key = string.upper(tostring(value or "COMMON"))
    return rarityAliases[key] or key
end

local function keptRarityCount()
    local n = 0
    for _, info in ipairs(rarityList) do
        if keepRarities[info.key] == true then
            n = n + 1
        end
    end
    return n
end

