local function cloneRoute(source)
    local result = {}
    for i, item in ipairs(source) do
        result[i] = {
            name = tostring(item.name or ("Локация " .. i)),
            pos = Vector3.new(item.pos.X, item.pos.Y, item.pos.Z),
            wait = tonumber(item.wait) or 2,
            isChest = item.isChest == true,
        }
    end
    return result
end

