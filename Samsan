-- =========================================================
-- EVENT-DRIVEN FARM 61–75
-- =========================================================

local activeEnemies = {}
local enemyOrder = {}
local lastSpawnZ = nil
local lastUnlockedStage = nil
local FARM_STOP_STAGE = 75
local NEXT_STAGE_STEP = 92

local acceptedAttackCount = 0
local acceptedAttackRate = 0
local acceptedWindowStart = os.clock()

addConnection(AttackStarted.OnClientEvent:Connect(function()
    acceptedAttackCount += 1

    local now = os.clock()
    local elapsed = now - acceptedWindowStart

    if elapsed >= 1 then
        acceptedAttackRate = acceptedAttackCount / elapsed
        acceptedAttackCount = 0
        acceptedWindowStart = now
    end
end))

local function enemyCount()
    local n = 0
    for _ in pairs(activeEnemies) do
        n = n + 1
    end
    return n
end

local function removeEnemyIdFromOrder(enemyId)
    for i = #enemyOrder, 1, -1 do
        if enemyOrder[i] == enemyId then
            table.remove(enemyOrder, i)
        end
    end
end

local function getNextEnemy()
    for i = 1, #enemyOrder do
        local id = enemyOrder[i]
        local data = activeEnemies[id]

        if data then
            return id, data
        end
    end

    return nil, nil
end

addConnection(EnemySpawned.OnClientEvent:Connect(function(
    enemyId,
    displayName,
    configName,
    isBoss,
    position,
    ...
)
    enemyId = tostring(enemyId)

    activeEnemies[enemyId] = {
        id = enemyId,
        name = tostring(displayName or configName or enemyId),
        position = position,
        boss = isBoss == true,
        spawnedAt = os.clock(),
    }

    removeEnemyIdFromOrder(enemyId)
    table.insert(enemyOrder, enemyId)

    if typeof(position) == "Vector3" then
        lastSpawnZ = position.Z
    end

    if state.autoFarm then
        setFarmStatus(
            string.format(
                "Моб: %s%s // активных %d",
                tostring(displayName or configName or enemyId),
                isBoss and " [BOSS]" or "",
                enemyCount()
            )
        )
    end
end))

addConnection(EnemyDied.OnClientEvent:Connect(function(enemyId)
    enemyId = tostring(enemyId)

    activeEnemies[enemyId] = nil
    removeEnemyIdFromOrder(enemyId)

    if state.autoFarm then
        setFarmStatus(
            "EnemyDied " ..
            enemyId ..
            " // осталось " ..
            tostring(enemyCount())
        )
    end
end))

addConnection(StageUnlocked.OnClientEvent:Connect(function(groupId, stageNumber)
    local stage = tonumber(stageNumber)

    if tonumber(groupId) ~= 5 or not stage then
        return
    end

    lastUnlockedStage = stage

    if state.autoFarm then
        setFarmStatus(
            "Этап " ..
            tostring(stage) ..
            " ЗАСЧИТАН ✓"
        )

        if stage >= FARM_STOP_STAGE then
            state.autoFarm = false
    state.turboAttack = false
            setFarmStatus("ГОТОВО // этап 75 засчитан")
            return
        end

        task.delay(0.35, function()
            if not state.autoFarm then
                return
            end

            local root = getRoot()
            if not root then
                return
            end

            -- Для перехода 74 → 75 используем точную координату пользователя.
            if stage == 74 then
                root.CFrame = CFrame.new(TARGET_75)
                setFarmStatus("74 ✓ // переход на 75")
                return
            end

            -- В логах арена идёт почти строго по +Z,
            -- примерно на 92 studs за обычный этап.
            local current = root.Position
            local targetZ =
                (lastSpawnZ or current.Z) + NEXT_STAGE_STEP

            root.CFrame = CFrame.new(
                3001.5,
                math.max(current.Y, 6),
                targetZ
            )

            setFarmStatus(
                tostring(stage) ..
                " ✓ // идём на " ..
                tostring(stage + 1)
            )
        end)
    end
end))

