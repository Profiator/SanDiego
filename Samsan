    if not scrolling then
        return
    end

    local cards = {}

    for _, child in ipairs(scrolling:GetChildren()) do
        if child:IsA("GuiButton") and tonumber(child.Name) then
            cards[#cards + 1] = child
        end
    end

    table.sort(cards, function(a, b)
        return (tonumber(a.Name) or 999) < (tonumber(b.Name) or 999)
    end)

    for _, card in ipairs(cards) do
        if not state.autoPlaytimeRewards or not alive then
            return
        end

        local ready, info = playtimeCardIsReady(card)

        if ready then
            local key = tostring(card.Name)
            local now = os.clock()
            local lastAttempt = playtimeLastAttempt[key] or 0

            -- Не спамим одну карточку десятками сигналов в одну секунду.
            if now - lastAttempt >= 0.45 then
                playtimeLastAttempt[key] = now

                local ok, method = triggerPlaytimeCard(card)

                if ok then
                    playtimeClaimedCount += 1
                    playtimeLastAttempt[key] = os.clock()

                    print(string.format(
                        "[AUTO PLAYTIME] награда #%s получена // %s // всего %d",
