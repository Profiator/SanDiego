--========================================================
-- ПОЛУЧЕНИЕ ЧАСТИ ТЕЛА
--========================================================

local function getAimPart(character)

	local profile = getProfile()


	if profile.Target == "HEAD" then

		return character:FindFirstChild("Head", true)
	end


	return
		character:FindFirstChild("UpperTorso", true)

		or character:FindFirstChild("Torso", true)

		or character:FindFirstChild("HumanoidRootPart", true)
end


--========================================================
-- ПРОВЕРКА ЦЕЛИ
--========================================================

local function validPlayer(player)

	if player == LocalPlayer then

		return false
	end


	if Settings.TeamCheck then

		if LocalPlayer.Team
			and player.Team
			and LocalPlayer.Team == player.Team then

			return false
		end
	end


	local character = player.Character

	if not character then

		return false
	end


	local humanoid =
		character:FindFirstChildOfClass("Humanoid")


	if not humanoid then

		return false
	end


	if humanoid.Health <= 0 then

		return false
	end


	if not getAimPart(character) then

		return false
	end


	return true
end


--========================================================
-- ПРОВЕРКА СТЕН
--========================================================

local function visibleTarget(character, aimPart)

	if not Settings.WallCheck then

		return true
	end


	local params = RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude


	if LocalPlayer.Character then

		params.FilterDescendantsInstances = {
			LocalPlayer.Character
		}
	end


	local origin =
		Camera.CFrame.Position


	local direction =
		aimPart.Position
		-
		origin


	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)


	if not result then

		return true
	end


	return
		result.Instance:IsDescendantOf(
			character
		)
end


--========================================================
-- НАЙТИ БЛИЖАЙШУЮ ЦЕЛЬ В КРУГЕ
--========================================================

local function findTargetInCircle()

	Camera = workspace.CurrentCamera


	if not Camera then

		return nil
	end


	local profile = getProfile()


	local viewport =
		Camera.ViewportSize


	local center =
		Vector2.new(
			viewport.X / 2,
			viewport.Y / 2
		)


	local bestPlayer = nil

	local bestScreenDistance =
		profile.FOV


	for _, player in ipairs(
		Players:GetPlayers()
	) do


		if validPlayer(player) then

			local character =
				player.Character


			local aimPart =
				getAimPart(character)


			if aimPart then

				local worldDistance =

					(
						aimPart.Position
						-
						Camera.CFrame.Position
					).Magnitude


				if worldDistance <=
					Settings.MaxDistance then


					local screenPoint,
						onScreen =

						Camera:WorldToViewportPoint(
							aimPart.Position
						)


					if onScreen
						and screenPoint.Z > 0 then


						local position =
							Vector2.new(
								screenPoint.X,
								screenPoint.Y
							)


						local screenDistance =
							(
								position
								-
								center
							).Magnitude


						if screenDistance <=
							profile.FOV
							and
							screenDistance <
							bestScreenDistance
						then


							if visibleTarget(
								character,
								aimPart
							) then


								bestScreenDistance =
									screenDistance


								bestPlayer =
									player
							end
						end
					end
				end
			end
		end
	end


	return bestPlayer
end


--========================================================
-- ПРОВЕРКА БИНДА
--========================================================

local function isAimBind(input)

	if AimMouseButton then

		return
			input.UserInputType ==
			AimMouseButton
	end


	if AimKeyCode then

		return
			input.KeyCode ==
			AimKeyCode
	end


	return false
end


--========================================================
-- КУРСОР НАХОДИТСЯ НА МЕНЮ?
--========================================================

local function mouseInsideMenu()

	if not Menu.Visible then

		return false
	end


	local mouse =
		UIS:GetMouseLocation()


	local pos =
		Menu.AbsolutePosition


	local size =
		Menu.AbsoluteSize


	return

		mouse.X >= pos.X

		and mouse.X <= pos.X + size.X

		and mouse.Y >= pos.Y

		and mouse.Y <= pos.Y + size.Y
end


--========================================================
-- НАЖАТИЕ
--========================================================

UIS.InputBegan:Connect(function(input)

	--====================================================
	-- НАЗНАЧЕНИЕ НОВОГО БИНДА
	--====================================================

	if WaitingForBind then


		if input.KeyCode ==
			Enum.KeyCode.Escape then

			WaitingForBind = false

			updateMenu()

			return
		end


		if input.UserInputType ==
			Enum.UserInputType.Keyboard
		then


			if input.KeyCode ~=
				Enum.KeyCode.Unknown
			then


				AimKeyCode =
					input.KeyCode


				AimMouseButton = nil


				WaitingForBind = false


				updateMenu()


				return
			end
		end


		if input.UserInputType ==
			Enum.UserInputType.MouseButton1

			or input.UserInputType ==
			Enum.UserInputType.MouseButton2

			or input.UserInputType ==
			Enum.UserInputType.MouseButton3
		then


			AimMouseButton =
				input.UserInputType


			AimKeyCode = nil


			WaitingForBind = false


			updateMenu()


			return
		end
	end


	if UIS:GetFocusedTextBox() then

		return
	end


	if isAimBind(input) then


		if mouseInsideMenu() then

			return
		end


		local profile = getProfile()


		if not Settings.Enabled
			or not profile.Enabled then

			return
		end


		AimHeld = true


		-- Сразу ищем цель внутри круга.
		LockedPlayer =
			findTargetInCircle()


		if LockedPlayer then

			Status.Text =
				"ЗАХВАЧЕН: "
				..
				LockedPlayer.Name

		else

			Status.Text =
				"ИЩУ ЦЕЛЬ В КРУГЕ"
		end
	end
end)


--========================================================
-- ОТПУСКАНИЕ
--========================================================

UIS.InputEnded:Connect(function(input)

	if isAimBind(input) then

		AimHeld = false

		LockedPlayer = nil

		Status.Text =
			"СТАТУС: ОЖИДАНИЕ"
	end
end)


