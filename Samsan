local function guiReallyVisible(obj)
    if not obj or not obj.Parent or not obj:IsA("GuiObject") or not obj.Visible then return false end
    local cur = obj.Parent
    while cur and cur ~= playerGui do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function physicalGuiClick(button)
    if not button or not button.Parent or not guiReallyVisible(button) then return false end

    local x = math.floor(button.AbsolutePosition.X + button.AbsoluteSize.X * 0.5)
    local y = math.floor(button.AbsolutePosition.Y + button.AbsoluteSize.Y * 0.5)

    local ok = pcall(function()
        -- Сначала ставим виртуальный курсор точно в центр кнопки.
        VirtualInputManager:SendMouseMoveEvent(x, y, game)
        task.wait(0.04)

        -- Полный down/up, чуть дольше прежнего.
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.10)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)

    if ok then return true end

    -- Дополнительный fallback через VirtualUser.
    return pcall(function()
        camera = workspace.CurrentCamera or camera
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(x, y), camera and camera.CFrame or CFrame.new())
        task.wait(0.10)
        VirtualUser:Button1Up(Vector2.new(x, y), camera and camera.CFrame or CFrame.new())
    end)
end

local function clickGuiButton(button)
    return physicalGuiClick(button)
end

local function clickEndlessStartButton(button)
    if not button or not button.Parent or not guiReallyVisible(button) then
        return false
    end

    local sent = false

    -- Executor-friendly direct GUI signals.
    -- Success is NOT assumed from this: below we still wait until the GAME
    -- itself moves the character away from the portal.
    if type(firesignal) == "function" then
        local ok1 = pcall(function()
            firesignal(button.MouseButton1Click)
        end)
        sent = sent or ok1

        local ok2 = pcall(function()
            firesignal(button.Activated)
        end)
        sent = sent or ok2
    end

    -- Also send a real virtual mouse click into the center of the button.
    local ok3 = physicalGuiClick(button)
    sent = sent or ok3

    return sent
end

local function gameMovedPlayerToEndlessArena()
    local root = getRoot()
    if not root then return false end

    -- HOME находится примерно в 80 studs от портала, поэтому порог 180
    -- не примет обычный респавн/дом за успешный вход в Endless.
    local distanceFromPortal = (root.Position - FLOOR_PORTAL).Magnitude
    return distanceFromPortal >= 180
end

local function waitSecondsOnPortal(seconds, statusPrefix)
    local duration = math.max(0, tonumber(seconds) or 0)
    local startedAt = os.clock()

    while alive and state.routeFarm and farmMode == "FLOORS" do
        if gameMovedPlayerToEndlessArena() then
            return true, "GAME_TP"
        end

        local elapsed = os.clock() - startedAt
        if elapsed >= duration then
            return true, "TIME"
        end

        local remaining = math.max(0, duration - elapsed)
        setFarmStatus(string.format(
            "%s // %.1f сек",
            statusPrefix or "ЭТАЖИ // ждём",
            remaining
        ))
        task.wait(0.10)
    end

    return false, "STOPPED"
end

local function pressStartUntilGameTeleport()
    -- V39: после появления START ждём только 2 секунды.
    local okWait = waitSecondsOnPortal(
        2,
        "ЭТАЖИ // START найден ✓ // первый клик через"
    )
    if not okWait or not state.routeFarm then return false end

    local attempt = 0
    local lastClickAt = 0

    -- Не считаем скрытие меню успехом. Успех только когда сама ИГРА
    -- реально перенесла персонажа далеко от портала.
    while alive and state.routeFarm and farmMode == "FLOORS" do
        if gameMovedPlayerToEndlessArena() then
            local root = getRoot()
            setFarmStatus(string.format(
                "ЭТАЖИ // игра перенесла на арену ✓ // Y %.1f",
                root and root.Position.Y or 0
            ))
            return true
        end

        local button = getEndlessStartButton()

        if button and guiReallyVisible(button) and button.Active then
            if os.clock() - lastClickAt >= 0.45 then
                attempt += 1
                lastClickAt = os.clock()

                setFarmStatus(
                    "ЭТАЖИ // START попытка #" .. tostring(attempt) ..
                    " // ждём TP игры"
                )

                clickEndlessStartButton(button)
            end
        else
            setFarmStatus(
                "ЭТАЖИ // START скрыт // ждём TP игры или возврат кнопки"
            )
        end

        task.wait(0.08)
    end

    return false
end

