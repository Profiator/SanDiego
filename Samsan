local function parseXYZ(raw)
    local nums = {}
    for token in string.gmatch(tostring(raw or ""), "[-+]?%d*%.?%d+") do
        local n = tonumber(token)
        if n then
            nums[#nums + 1] = n
            if #nums >= 3 then break end
        end
    end
    if #nums < 3 then return nil end
    return Vector3.new(nums[1], nums[2], nums[3])
end

local function formatXYZ(pos)
    return string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
end

local function safeTeleport(pos)
    local root = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return false end
    return pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(pos)
    end)
end

