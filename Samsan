local function makeToggle(row, initial, onChange)
    local state = initial
    local b = Instance.new("TextButton")
    b.AnchorPoint = Vector2.new(1,0.5)
    b.Position = UDim2.new(1,-10,0.5,0)
    b.Size = UDim2.fromOffset(62,27)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.TextColor3 = Color3.new(1,1,1)
    b.Parent = row
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1,0)
    c.Parent = b

    local function draw()
        if state then
            b.BackgroundColor3 = Color3.fromRGB(42,190,85)
            b.Text = "ВКЛ"
        else
            b.BackgroundColor3 = Color3.fromRGB(65,67,76)
            b.Text = "ВЫКЛ"
        end
    end

    b.MouseButton1Click:Connect(function()
        state = not state
        draw()
        onChange(state)
    end)
    draw()
end

local eventRow = makeRow(47, "Автособытие Luck x100 / 10 мин")
makeToggle(eventRow, AUTO_EVENT, function(v)
    AUTO_EVENT = v
    if v then nextEventAt = 0 end
end)

local sellRow = makeRow(96, "Автопродажа после фарма")
makeToggle(sellRow, AUTO_SELL, function(v)
    AUTO_SELL = v
end)

local rarityRow, rarityLabel = makeRow(145, "Оставлять")
rarityLabel.Size = UDim2.new(1,-145,1,0)

local rarityButton = Instance.new("TextButton")
rarityButton.AnchorPoint = Vector2.new(1,0.5)
rarityButton.Position = UDim2.new(1,-10,0.5,0)
rarityButton.Size = UDim2.fromOffset(125,27)
rarityButton.BackgroundColor3 = Color3.fromRGB(92,62,195)
rarityButton.BorderSizePixel = 0
rarityButton.Font = Enum.Font.GothamBold
rarityButton.TextColor3 = Color3.new(1,1,1)
rarityButton.TextSize = 9
rarityButton.Parent = rarityRow
local rc = Instance.new("UICorner")
rc.CornerRadius = UDim.new(0,7)
rc.Parent = rarityButton

local function drawRarity()
    rarityButton.Text = rarityList[keepIndex].name .. "+"
end

rarityButton.MouseButton1Click:Connect(function()
    keepIndex = keepIndex + 1
    if keepIndex > #rarityList then keepIndex = 1 end
    drawRarity()
    print("[Arc2play] KEEP:", rarityList[keepIndex].name .. "+")
end)

drawRarity()
print("[Arc2play] Auto Event + Auto Sell loaded")
