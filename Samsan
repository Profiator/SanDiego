afTitle.TextXAlignment = Enum.TextXAlignment.Center

local afText = label(autofarmPage, "MODULE RESERVED // WE ADD IT LATER", UDim2.fromOffset(4, 56), UDim2.new(1, -8, 0, 28), 10, C.muted, Enum.Font.Code)
afText.TextXAlignment = Enum.TextXAlignment.Center

local function getCoordString()
    local root = getRoot()
    if not root then
        return "X 0.00   Y 0.00   Z 0.00", "0.00, 0.00, 0.00"
    end

    local p = root.Position
    return string.format("X %.2f   Y %.2f   Z %.2f", p.X, p.Y, p.Z),
           string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
end

addConnection(copyBtn.MouseButton1Click:Connect(function()
    local _, raw = getCoordString()
    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, raw)
    elseif type(toclipboard) == "function" then
        copied = pcall(toclipboard, raw)
    end

    if not copied then
        print("[CYBER PANEL] COORDS:", raw)
    end

    local old = copyBtn.Text
    copyBtn.Text = copied and "COPIED" or "PRINTED"
    task.delay(0.8, function()
        if copyBtn and copyBtn.Parent then copyBtn.Text = old end
    end)
end))

addConnection(RunService.Stepped:Connect(function()
    if not alive or not state.noclip then return end
    local char = getCharacter()
    if not char then return end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollisions[obj] == nil then
                originalCollisions[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end
end))

addConnection(RunService.Heartbeat:Connect(function()
    if not alive or not state.speed then return end
    local humanoid = getHumanoid()
    if humanoid and humanoid.WalkSpeed ~= state.speedValue then
        humanoid.WalkSpeed = state.speedValue
    end
end))

local flyKeys = {W=false,A=false,S=false,D=false,UP=false,DOWN=false}
local keyMap = {
    [Enum.KeyCode.W]="W",
    [Enum.KeyCode.A]="A",
    [Enum.KeyCode.S]="S",
    [Enum.KeyCode.D]="D",
    [Enum.KeyCode.Space]="UP",
    [Enum.KeyCode.LeftControl]="DOWN",
    [Enum.KeyCode.RightControl]="DOWN",
}

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local k = keyMap[input.KeyCode]
    if k then flyKeys[k] = true end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    local k = keyMap[input.KeyCode]
    if k then flyKeys[k] = false end
end))

addConnection(RunService.RenderStepped:Connect(function()
    if not alive then return end

    local display = getCoordString()
    coordsLabel.Text = display

    if not state.fly then return end

    camera = workspace.CurrentCamera or camera
    local root = getRoot()
    local humanoid = getHumanoid()
    if not root or not humanoid or not camera then return end

    humanoid.PlatformStand = true

    local direction = Vector3.zero
    local cf = camera.CFrame

    if flyKeys.W then direction += cf.LookVector end
    if flyKeys.S then direction -= cf.LookVector end
    if flyKeys.D then direction += cf.RightVector end
    if flyKeys.A then direction -= cf.RightVector end
    if flyKeys.UP then direction += Vector3.yAxis end
    if flyKeys.DOWN then direction -= Vector3.yAxis end

    if direction.Magnitude > 0 then direction = direction.Unit end

    root.AssemblyLinearVelocity = direction * state.flySpeed
    root.AssemblyAngularVelocity = Vector3.zero
end))

addConnection(UserInputService.JumpRequest:Connect(function()
    if not alive or not state.infiniteJump then return end
    local humanoid = getHumanoid()
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end))

task.spawn(function()
    while alive do
        if state.autoClick then
            local mousePos = UserInputService:GetMouseLocation()
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 0)
                task.wait(0.025)
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 0)
            end)
            task.wait(state.clickInterval)
        else
            task.wait(0.08)
        end
    end
end)

addConnection(player.CharacterAdded:Connect(function(char)
    originalWalkSpeed = nil
    table.clear(originalCollisions)

    local humanoid = char:WaitForChild("Humanoid", 10)
    task.wait(0.2)

    if state.speed and humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = state.speedValue
    end

    if state.fly and humanoid then
        humanoid.PlatformStand = true
    end
end))

do
    local dragging = false
    local dragStart
    local startPos

    addConnection(main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local y = input.Position.Y - main.AbsolutePosition.Y
            if y <= 62 then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end
    end))

    addConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    addConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

local function shutdown()
    if not alive then return end
    alive = false

    state.speed = false
    state.noclip = false
    state.fly = false
    state.autoClick = false
    state.infiniteJump = false

    local humanoid = getHumanoid()
    local root = getRoot()

    if humanoid then
        if originalWalkSpeed ~= nil then
            pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
        end
        pcall(function() humanoid.PlatformStand = false end)
    end

    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    for part, oldValue in pairs(originalCollisions) do
        if part and part.Parent then
            pcall(function() part.CanCollide = oldValue end)
        end
    end

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end

    if gui then gui:Destroy() end
end

addConnection(closeBtn.MouseButton1Click:Connect(shutdown))

print("[CYBER PANEL V1] Loaded")
print("[CYBER PANEL V1] All functions start OFF")
