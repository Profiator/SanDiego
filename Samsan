local dragging = false
local dragStart
local startPos

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local Enabled = false
local LoopRunning = false

local function updateVisual()
    if Enabled then
        TweenService:Create(
            Switch,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Color3.fromRGB(190, 30, 43)}
        ):Play()

        TweenService:Create(
            Knob,
            TweenInfo.new(0.2),
            {Position = UDim2.fromOffset(23, 3)}
        ):Play()

        ToggleStroke.Color = Color3.fromRGB(200, 35, 48)
        StatusDot.BackgroundColor3 = Color3.fromRGB(40, 215, 105)
        Status.Text = "Работает"
        Status.TextColor3 = Color3.fromRGB(80, 220, 125)
    else
        TweenService:Create(
            Switch,
            TweenInfo.new(0.2),
            {BackgroundColor3 = Color3.fromRGB(57, 57, 64)}
        ):Play()

        TweenService:Create(
            Knob,
            TweenInfo.new(0.2),
            {Position = UDim2.fromOffset(3, 3)}
        ):Play()

        ToggleStroke.Color = Color3.fromRGB(55, 55, 63)
        StatusDot.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
        Status.Text = "Остановлен"
        Status.TextColor3 = Color3.fromRGB(170, 170, 180)
    end
end

local function startCollectLoop()
    if LoopRunning then
        return
    end

    LoopRunning = true

    task.spawn(function()
        while Enabled and ScreenGui.Parent do
            local current = Player:GetAttribute("Leaves") or 0
            local capacity = Player:GetAttribute("LeafCapacity") or 25

            LeavesText.Text = ("Листья: %d / %d"):format(current, capacity)

            if not LeafSim then
                Status.Text = "LeafSim не найден"
                Status.TextColor3 = Color3.fromRGB(230, 80, 80)
                StatusDot.BackgroundColor3 = Color3.fromRGB(230, 55, 65)
                task.wait(1)
                continue
            end

            if current >= capacity then
                Status.Text = "Мешок заполнен"
                Status.TextColor3 = Color3.fromRGB(245, 180, 70)
                StatusDot.BackgroundColor3 = Color3.fromRGB(245, 180, 70)
                task.wait(0.25)
                continue
            end

            local character = Player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local folder = LeafSim.folder

            if root and folder then
                local nearest
                local nearestDistance = math.huge

                for _, leaf in ipairs(folder:GetChildren()) do
                    if leaf:IsA("BasePart") and leaf.Parent == folder then
                        local d = (leaf.Position - root.Position).Magnitude

                        if d < nearestDistance then
                            nearestDistance = d
                            nearest = leaf
                        end
                    end
                end

                if nearest then
                    pcall(function()
                        LeafSim.collect(nearest)
                    end)
                end
            end

            task.wait(0.15)
        end

        LoopRunning = false
    end)
end

Toggle.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    updateVisual()

    if Enabled then
        startCollectLoop()
    end
end)

task.spawn(function()
    while ScreenGui.Parent do
        local current = Player:GetAttribute("Leaves") or 0
        local capacity = Player:GetAttribute("LeafCapacity") or 25

        LeavesText.Text = ("Листья: %d / %d"):format(current, capacity)

        if Enabled and current < capacity and LeafSim then
            Status.Text = "Работает"
            Status.TextColor3 = Color3.fromRGB(80, 220, 125)
            StatusDot.BackgroundColor3 = Color3.fromRGB(40, 215, 105)
        end

        task.wait(0.25)
    end
end)

