-- =====================================================================
-- УЛЬТРА-АНТИЧИТ (АБСОЛЮТНАЯ ЗАЩИТА)
-- =====================================================================
pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index
    local oldNewIndex = mt.__newindex
    setreadonly(mt, false)

    -- Перехват всех вызовов методов
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            -- Блокировка киков, телепортов, банов
            if method == "Kick" or method == "kick" or method == "Teleport" or method == "TeleportToPlaceInstance" then
                return nil
            end
            -- Блокировка подозрительных серверных вызовов
            if method == "FireServer" or method == "InvokeServer" then
                local name = tostring(self):lower()
                if name:find("ban") or name:find("kick") or name:find("punish") or name:find("cheat") or name:find("log") or name:find("detect") or name:find("anticheat") or name:find("report") or name:find("crash") or name:find("error") or name:find("suspicious") or name:find("exploit") or name:find("admin") or name:find("kill") or name:find("remove") or name:find("script") then
                    return nil
                end
            end
            -- Скрытие физических объектов (полёт и скорость не обнаружится)
            if method == "FindFirstChild" or method == "FindFirstChildOfClass" or method == "FindFirstChildWhichIsA" then
                local args = {...}
                if type(args[1]) == "string" then
                    local n = tostring(args[1])
                    if n == "BodyVelocity" or n == "BodyGyro" or n == "BodyForce" or n == "BodyPosition" or n == "RocketPropulsion" or n == "AlignPosition" or n == "AlignOrientation" or n == "BodyThrust" or n == "BodyAngularVelocity" or n == "LinearVelocity" or n == "AngularVelocity" then
                        local lp = game:GetService("Players").LocalPlayer
                        if lp and lp.Character and self:IsDescendantOf(lp.Character) then
                            return nil
                        end
                    end
                end
            end
            -- Блокировка проверок на модификации (античит скриптов)
            if method == "GetAttribute" or method == "GetPropertyChangedSignal" then
                local name = tostring(self):lower()
                if name:find("velocity") or name:find("speed") or name:find("health") or name:find("jumppower") then
                    return nil
                end
            end
        end

        -- Логирование действий (опционально)
        if _G.ActionRecorder and _G.ActionRecorder.Recording then
            local args = {...}
            pcall(function()
                if method == "FireServer" or method == "InvokeServer" then
                    local argStr = ""
                    for i, v in ipairs(args) do
                        local vStr = "<err>"
                        pcall(function()
                            if typeof(v) == "Instance" then vStr = v.Name else vStr = tostring(v) end
                        end)
                        argStr = argStr .. typeof(v) .. "(" .. vStr .. "), "
                    end
                    local selfName = "<err>"
                    pcall(function() selfName = self.Name end)
                    table.insert(_G.ActionRecorder.Logs, string.format("[%s] %s: %s | Args: %s", os.date("%X"), method, selfName, argStr))
                end
            end)
        end
        return oldNamecall(self, ...)
    end)

    -- Перехват чтения свойств (подмена значений для сервера)
    mt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            -- Фальшивые значения физики
            if key == "WalkSpeed" then return 16 end
            if key == "JumpPower" then return 50 end
            if key == "JumpHeight" then return 7.2 end
            if key == "Transparency" and self:IsA("BasePart") then return 0 end
            if key == "AssemblyLinearVelocity" and self:IsA("BasePart") then return Vector3.new(0,0,0) end
            if key == "CFrame" and typeof(self) == "Instance" and self:IsA("HumanoidRootPart") then
                -- Подмена CFrame на сохранённый "легитимный" для сервера
                if _G.FakeCFrame and self == LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    return _G.FakeCFrame
                end
            end
        end
        return oldIndex(self, key)
    end)

    -- Перехват записи свойств (блокировка изменений античитом)
    mt.__newindex = newcclosure(function(self, key, value)
        if not checkcaller() then
            if key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" then return end
            if key == "AssemblyLinearVelocity" or key == "Velocity" then return end
            if key == "CFrame" and typeof(self) == "Instance" and self:IsA("HumanoidRootPart") then
                -- Разрешаем изменения только внутри нашего кода, но для внешних блокируем
                if not _G.AllowCFrameChange then
                    return
                end
            end
        end
        return oldNewIndex(self, key, value)
    end)

    setreadonly(mt, true)

    -- Полное отключение логов и ошибок
    local ScriptContext = game:GetService("ScriptContext")
    local LogService = game:GetService("LogService")
    for _, conn in ipairs(getconnections(ScriptContext.Error)) do
        conn:Disable()
    end
    for _, conn in ipairs(getconnections(LogService.MessageOut)) do
        conn:Disable()
    end

    -- Отключение стандартного анти-АФК
    pcall(function()
        for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
            if conn.Disable then conn:Disable() end
        end
    end)

    -- Блокировка LocalPlayer.Kick напрямую
    pcall(function()
        if hookfunction then
            hookfunction(LocalPlayer.Kick, function() return nil end)
        else
            LocalPlayer.Kick = function() return nil end
        end
    end)

    -- Имитация случайных действий, чтобы не выглядеть ботом
    task.spawn(function()
        while true do
            task.wait(math.random(10, 30))
            if not checkcaller() then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.A, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
            end
        end
    end)
end)

