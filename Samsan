    (type(getgenv) == "function" and getgenv()) or _G

local LOCAL_ROUTE_CACHE_KEY =
    "__CYBER_ROUTE_CACHE_V30_" ..
    tostring((game.GameId ~= 0 and game.GameId) or game.PlaceId)

local function routeToSerializable()
    local points = {}
    for i, item in ipairs(routePoints) do
        points[i] = {
            name = tostring(item.name or ("Локация " .. tostring(i))),
            x = tonumber(item.pos and item.pos.X) or 0,
            y = tonumber(item.pos and item.pos.Y) or 0,
            z = tonumber(item.pos and item.pos.Z) or 0,
            wait = tonumber(item.wait) or 2,
            isChest = item.isChest == true,
        }
    end
    return {
        version = 1,
        home = { x = routeStart.X, y = routeStart.Y, z = routeStart.Z },
        points = points,
    }
end

local function saveRouteLocal(silent)
    local snapshot = routeToSerializable()
    localEnv[LOCAL_ROUTE_CACHE_KEY] = snapshot

    if not localRouteFileAvailable then
        if not silent then setFarmStatus("Маршрут сохранён локально в памяти Xeno") end
        return true
    end

    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode(snapshot)
    end)

    if not okEncode or type(encoded) ~= "string" then
        if not silent then setFarmStatus("Маршрут в памяти // ошибка JSON-файла") end
        return true
    end

    local okWrite, err = pcall(function()
        writefile(LOCAL_ROUTE_FILE, encoded)
    end)

    if not okWrite then
        if not silent then
            setFarmStatus("Маршрут в памяти // файл не записан: " .. tostring(err))
        end
        return true
    end
    return true
end

local function loadRouteLocal()
    local data = nil

    if localRouteFileAvailable then
        local mayRead = true
        if type(isfile) == "function" then
            local okExists, exists = pcall(isfile, LOCAL_ROUTE_FILE)
            if okExists and not exists then mayRead = false end
        end
        if mayRead then
            local okRead, raw = pcall(function() return readfile(LOCAL_ROUTE_FILE) end)
            if okRead and type(raw) == "string" and raw ~= "" then
                local okDecode, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
                if okDecode and type(decoded) == "table" then data = decoded end
            end
        end
    end

    if type(data) ~= "table" then
        local cached = localEnv[LOCAL_ROUTE_CACHE_KEY]
        if type(cached) == "table" then data = cached end
    end

    if type(data) ~= "table" then return false end

    if type(data.home) == "table" then
        local hx = tonumber(data.home.x)
        local hy = tonumber(data.home.y)
        local hz = tonumber(data.home.z)
        if hx and hy and hz then routeStart = Vector3.new(hx, hy, hz) end
    end

    if type(data.points) == "table" then
        local restored = {}
        for i, item in ipairs(data.points) do
            if type(item) == "table" then
                local x = tonumber(item.x)
                local y = tonumber(item.y)
                local z = tonumber(item.z)
                local seconds = tonumber(item.wait)
                if x and y and z then
                    restored[#restored + 1] = {
                        name = tostring(item.name or ("Локация " .. tostring(i))),
                        pos = Vector3.new(x, y, z),
                        wait = math.clamp(seconds or 2, 0.05, 3600),
                        isChest = item.isChest == true,
                    }
                end
            end
        end
        routePoints = restored
    end
    return true
end

