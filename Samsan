    [Enum.KeyCode.RightControl] = "DOWN",
}

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = keyMap[input.KeyCode]
    if key then flyKeys[key] = true end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    local key = keyMap[input.KeyCode]
    if key then flyKeys[key] = false end
end))

addConnection(RunService.RenderStepped:Connect(function()
    if not alive then return end
    local display = coordinateStrings()
    coordsLabel.Text = display
    if not state.fly then return end

    camera = workspace.CurrentCamera or camera
    local root = getRoot()
    local humanoid = getHumanoid()
    if not root or not humanoid or not camera then return end

    humanoid.PlatformStand = true

    local direction = Vector3.zero
    local cf = camera.CFrame
    if flyKeys.W then direction += cf.LookVector end
    if flyKeys.S then direction -= cf.LookVector end
    if flyKeys.D then direction += cf.RightVector end
    if flyKeys.A then direction -= cf.RightVector end
    if flyKeys.UP then direction += Vector3.yAxis end
    if flyKeys.DOWN then direction -= Vector3.yAxis end
    if direction.Magnitude > 0 then direction = direction.Unit end

    root.AssemblyLinearVelocity = direction * state.flySpeed
    root.AssemblyAngularVelocity = Vector3.zero
end))

addConnection(UserInputService.JumpRequest:Connect(function()
    if not alive or not state.infiniteJump then return end
    local humanoid = getHumanoid()
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end))

addConnection(player.CharacterAdded:Connect(function(char)
    originalWalkSpeed = nil
    table.clear(originalCollisions)
    local humanoid = char:WaitForChild("Humanoid", 10)
    task.wait(0.15)
    if state.speed and humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = state.speedValue
    end
    if state.fly and humanoid then
        humanoid.PlatformStand = true
    end
end))

-- =========================================================
-- DRAG HEADER
-- =========================================================

do
    local dragging = false
    local dragStart = nil
    local startPos = nil

    addConnection(main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            local localY = input.Position.Y - main.AbsolutePosition.Y
            if localY <= 48 then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end
    end))

    addConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    addConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

-- =========================================================
-- SHUTDOWN
-- =========================================================

local function shutdown()
    if not alive then return end
    alive = false
    state.speed = false
    state.noclip = false
    state.fly = false
    state.autoClick = false
    state.infiniteJump = false
    state.autoRebirth = false
    state.antiAfk = false
    state.routeFarm = false
    state.powerMultiplier = 1
    state.damageMultiplier = 1
    routeIndex = 1
    routeStarted = false
    restoreIdleConnections()

    local humanoid = getHumanoid()
    local root = getRoot()
    if humanoid then
        if originalWalkSpeed ~= nil then
            pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
        end
        pcall(function() humanoid.PlatformStand = false end)
    end
    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    for part, oldValue in pairs(originalCollisions) do
        if part and part.Parent then
            pcall(function() part.CanCollide = oldValue end)
        end
    end
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    if gui then gui:Destroy() end
end

addConnection(closeBtn.MouseButton1Click:Connect(shutdown))

