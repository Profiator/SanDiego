--[[
ARC2PLAY AUTO MANAGER V2
    Mega Ramp for Slime

    FIXES:
    - Uses the REAL existing event:
      SATURN_LUCK_3X_RAINBOW_FOUR_LEAF_CLOVER_MILLIONAIRE
    - Renews from the server EventSystemEndsAt timestamp.
    - Reads the game's CURRENT inventory from the InventoryUpdate connection
      when Xeno exposes getconnections/debug.getupvalue.
    - Sells in descending Index order so shifting inventory indices do not break
      the rest of a sell batch.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local EventShopAction = remotes:WaitForChild("EventShopAction")
local InventoryUpdate = remotes:WaitForChild("InventoryUpdate")
local SlimeReveal = remotes:WaitForChild("SlimeReveal")
local SellSlimeAction = remotes:WaitForChild("SellSlimeAction")

-- =========================================================
-- REAL EVENT FROM EventConfig
-- =========================================================

local EVENT_ID = "SATURN_LUCK_3X_RAINBOW_FOUR_LEAF_CLOVER_MILLIONAIRE"

local AUTO_EVENT = true
local AUTO_SELL = true

local KEEP_PURCHASED = true
local KEEP_VIP = true
local KEEP_EQUIPPED = true

local SELL_AFTER_REVEAL = 2.35
local SELL_INTERVAL = 0.18
local BUY_RETRY = 5
local STATE_REFRESH = 8

-- =========================================================
-- RARITIES
-- Selected rarity is the MINIMUM rarity that will be kept.
-- MYTHIC+ => Common..Legendary sell; Mythic+ keep.
-- =========================================================

local rarityList = {
    {key="COMUNE",      name="COMMON",    rank=1},
    {key="NON COMUNE",  name="UNCOMMON",  rank=2},
    {key="RARO",        name="RARE",      rank=3},
    {key="EPICO",       name="EPIC",      rank=4},
    {key="LEGGENDARIO", name="LEGENDARY", rank=5},
    {key="MITICO",      name="MYTHIC",    rank=6},
    {key="SECRET",      name="SECRET",    rank=7},
    {key="DIVINO",      name="DIVINE",    rank=8},
    {key="LIMITED",     name="LIMITED",   rank=9},
}

local ranks = {
    ["COMUNE"]=1, ["COMMON"]=1,
    ["NON COMUNE"]=2, ["UNCOMMON"]=2,
    ["RARO"]=3, ["RARE"]=3,
    ["EPICO"]=4, ["EPIC"]=4,
    ["LEGGENDARIO"]=5, ["LEGENDARY"]=5,
    ["MITICO"]=6, ["MYTHIC"]=6,
    ["SECRET"]=7,
    ["DIVINO"]=8, ["DIVINE"]=8,
    ["LIMITED"]=9,
}

local keepIndex = 6 -- MYTHIC+

-- =========================================================
-- STATE
-- =========================================================

local latestInventory = {}
local inventoryVersion = 0

local selling = false
local revealGeneration = 0

local eventBusy = false
local lastBuyAttempt = -math.huge
local lastStateRequest = -math.huge

local statusEventText = "Инициализация..."
local statusSellText = "Ждём первый инвентарь..."

-- GUI refs assigned later
local eventStatusLabel
local sellStatusLabel
local rarityButton

-- =========================================================
-- HELPERS
-- =========================================================

local function log(...)
    print("[Arc2play V2]", ...)
end

local function setEventStatus(text)
    statusEventText = tostring(text)
    if eventStatusLabel then
        eventStatusLabel.Text = statusEventText
    end
end

local function setSellStatus(text)
    statusSellText = tostring(text)
    if sellStatusLabel then
        sellStatusLabel.Text = statusSellText
    end
end

local function getRank(rarity)
    return ranks[string.upper(tostring(rarity or "COMUNE"))] or 1
end

local function shouldKeep(slime)
    if type(slime) ~= "table" then
        return true
    end

    if KEEP_PURCHASED and (
        slime.IsPurchasedSlime == true or
        slime.NoEventCoins == true or
        tostring(slime.PaidItemType or "") == "PurchasedSlime"
    ) then
        return true
    end

    if KEEP_VIP and slime.IsVIP == true then
        return true
    end

    if KEEP_EQUIPPED and (
        slime.IsEquipped == true or
        slime.Equipped == true or
        slime.Selected == true
    ) then
        return true
    end

    return getRank(slime.Rarity) >= rarityList[keepIndex].rank
end

-- =========================================================
-- INVENTORY
-- =========================================================

InventoryUpdate.OnClientEvent:Connect(function(inventory)
    if type(inventory) == "table" then
        latestInventory = inventory
        inventoryVersion = inventoryVersion + 1
        setSellStatus(
            "Инвентарь: " .. tostring(#inventory) ..
            " | оставить " .. rarityList[keepIndex].name .. "+"
        )
    end
end)

local function looksLikeInventory(tbl)
    if type(tbl) ~= "table" then
        return false
    end

    local checked = 0

    for _, item in pairs(tbl) do
        if type(item) == "table" then
            checked = checked + 1

            if item.Rarity ~= nil and
               (item.Index ~= nil or item.InventoryIndex ~= nil) then
                return true
            end

            if checked >= 12 then
                break
            end
        end
    end

    return false
end

local function readUpvalue(fn, index)
    if not debug or type(debug.getupvalue) ~= "function" then
        return nil
    end

    local ok, a, b = pcall(debug.getupvalue, fn, index)

    if not ok then
        return nil
    end

    -- Standard Lua: name, value.
    if b ~= nil then
        return b
    end

    -- Some executors return value only.
    if type(a) ~= "string" then
        return a
    end

    return nil
end

local function getInventoryFromGameConnection()
    if type(getconnections) ~= "function" then
        return nil
    end

    local ok, connections = pcall(getconnections, InventoryUpdate.OnClientEvent)

    if not ok or type(connections) ~= "table" then
        return nil
    end

    for _, connection in ipairs(connections) do
        local fn = connection.Function or connection.Function

        if type(fn) == "function" then
            for i = 1, 20 do
                local value = readUpvalue(fn, i)

                if looksLikeInventory(value) then
                    return value
                end
            end
        end
    end

    return nil
end

local function getCurrentInventory()
    local live = getInventoryFromGameConnection()

    if looksLikeInventory(live) then
        latestInventory = live
        return live
    end

    return latestInventory
end

-- =========================================================
-- AUTO SELL
-- =========================================================

local function buildSellList(inventory)
    local result = {}

    if type(inventory) ~= "table" then
        return result
    end

    for _, slime in pairs(inventory) do
        if type(slime) == "table" and not shouldKeep(slime) then
            local index = tonumber(slime.Index or slime.InventoryIndex)

            if index then
                table.insert(result, {
                    index = index,
                    rarity = tostring(slime.Rarity or "?"),
                    name = tostring(slime.Name or slime.ModelName or "Slime"),
                })
            end
        end
    end

    -- Critical fix:
    -- if Index is an array position, deleting high -> low prevents shifts.
    table.sort(result, function(a, b)
        return a.index > b.index
    end)

    return result
end

local function autoSellNow()
    if not AUTO_SELL then
        setSellStatus("Автопродажа выключена")
        return
    end

    if selling then
        return
    end

    selling = true

    -- Give the game's own InventoryUpdate a moment to finish.
    task.wait(0.20)

    local inventory = getCurrentInventory()
    local sellList = buildSellList(inventory)

    if #sellList == 0 then
        setSellStatus(
            "Нечего продавать | оставить " ..
            rarityList[keepIndex].name .. "+"
        )
        selling = false
        return
    end

    setSellStatus("Продаём: " .. tostring(#sellList) .. " шт.")
    log("SELL START:", #sellList, "keep", rarityList[keepIndex].name .. "+")

    local sold = 0

    for _, item in ipairs(sellList) do
        if not AUTO_SELL then
            break
        end

        local ok, err = pcall(function()
            SellSlimeAction:FireServer("Sell", item.index)
        end)

        if ok then
            sold = sold + 1
            log("SELL", item.index, item.rarity, item.name)
        else
            warn("[Arc2play V2] Sell error:", err)
        end

        task.wait(SELL_INTERVAL)
    end

    task.wait(0.45)

    setSellStatus(
        "Продано запросов: " .. tostring(sold) ..
        " | оставить " .. rarityList[keepIndex].name .. "+"
    )

    selling = false
end

-- One sell pass after the LAST reveal in a rapid series.
SlimeReveal.OnClientEvent:Connect(function()
    if not AUTO_SELL then
        return
    end

    revealGeneration = revealGeneration + 1
    local myGeneration = revealGeneration

    setSellStatus("Получен слайм — ждём обновление...")

    task.delay(SELL_AFTER_REVEAL, function()
        if myGeneration ~= revealGeneration then
            return
        end

        autoSellNow()
    end)
end)

-- =========================================================
-- AUTO EVENT
-- =========================================================

local function requestEventState()
    if os.clock() - lastStateRequest < 0.5 then
        return
    end

    lastStateRequest = os.clock()

    pcall(function()
        EventShopAction:FireServer("RequestState")
    end)
end

local function getEventId()
    return tostring(
        player:GetAttribute("EventSystemActiveId") or
        player:GetAttribute("ActiveEventId") or
        ""
    )
end

local function getEventEndsAt()
    return tonumber(
        player:GetAttribute("EventSystemEndsAt") or
        player:GetAttribute("ActiveEventEndsAt") or
        0
    ) or 0
end

local function remainingSeconds()
    return math.max(0, getEventEndsAt() - os.time())
end

local function targetEventActive()
    return getEventId() == EVENT_ID and remainingSeconds() > 0
end

local function anyEventActive()
    return getEventId() ~= "" and remainingSeconds() > 0
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function tryBuyEvent(force)
    if not AUTO_EVENT and not force then
        return
    end

    if eventBusy then
        return
    end

    if not force and os.clock() - lastBuyAttempt < BUY_RETRY then
        return
    end

    requestEventState()
    task.wait(0.25)

    if targetEventActive() then
        setEventStatus("SATURN x3 активно: " .. formatTime(remainingSeconds()))
        return
    end

    if anyEventActive() then
        setEventStatus(
            "Ждём другое событие: " ..
            formatTime(remainingSeconds())
        )
        return
    end

    eventBusy = true
    lastBuyAttempt = os.clock()

    setEventStatus("Покупаем SATURN LUCK x3...")
    log("ACTIVATE", EVENT_ID)

    local ok, err = pcall(function()
        EventShopAction:FireServer("Activate", EVENT_ID)
    end)

    if not ok then
        warn("[Arc2play V2] Event Activate error:", err)
        setEventStatus("Ошибка отправки Activate")
        eventBusy = false
        return
    end

    -- Let server process purchase, then request authoritative state again.
    task.wait(1.0)
    requestEventState()
    task.wait(0.35)

    if targetEventActive() then
        setEventStatus("КУПЛЕНО • " .. formatTime(remainingSeconds()))
        log("EVENT ACTIVE:", formatTime(remainingSeconds()))
    else
        setEventStatus(
            "Не купилось — повтор через " ..
            tostring(BUY_RETRY) .. " сек"
        )
        warn(
            "[Arc2play V2] Activate was sent, but server did not report the target event active."
        )
    end

    eventBusy = false
end

-- Refresh status whenever server updates relevant attributes.
local function eventAttributeChanged()
    if targetEventActive() then
        setEventStatus("SATURN x3 активно: " .. formatTime(remainingSeconds()))
    end
end

player:GetAttributeChangedSignal("EventSystemActiveId"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("EventSystemEndsAt"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("ActiveEventId"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("ActiveEventEndsAt"):Connect(eventAttributeChanged)

task.spawn(function()
    task.wait(0.7)
    requestEventState()
    task.wait(0.5)

    -- AUTO_EVENT starts enabled, so it tries immediately if no event exists.
    tryBuyEvent(false)

    while task.wait(1) do
        if AUTO_EVENT then
            if os.clock() - lastStateRequest >= STATE_REFRESH then
                requestEventState()
            end

            if targetEventActive() then
                setEventStatus(
                    "SATURN x3 активно: " ..
                    formatTime(remainingSeconds())
                )
            elseif anyEventActive() then
                setEventStatus(
                    "Ждём другое событие: " ..
                    formatTime(remainingSeconds())
                )
            else
                -- The moment the old 10:00 event expires, buy again.
                tryBuyEvent(false)
            end
        else
            setEventStatus("Автопокупка выключена")
        end
    end
end)

