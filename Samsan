    end))
end

local function raceUseBoost(key)
    if not UseBoost then return false end
    key = tostring(key or "power5x")
    local packets = math.clamp(math.floor(boostState.racePackets or 12), 1, 64)
    boostState.activeBoosts[key] = boostState.lastKnownOwned[key] or 0
    for i = 1, packets do
        pcall(function() UseBoost:FireServer(key) end)
    end
    print(string.format("[BOOSTS] Отправлено %d пакетов UseBoost(\"%s\")",
        packets, key))
    return true
end

task.spawn(function()
    while alive do
        if boostState.autoUse and UseBoost then
            for key, count in pairs(boostState.lastKnownOwned) do
                if count and count > 0 then
                    raceUseBoost(key)
                    task.wait(0.35)
                end
            end
        end
        if boostState.raceMode and UseBoost then
            raceUseBoost(boostState.watchedKey)
            task.wait(0.6)
        end
        task.wait(0.2)
    end
end)

