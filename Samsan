local function coordinateStrings()
    local root = getRoot()
    if not root then
        return "X 0.00   Y 0.00   Z 0.00", "0.00, 0.00, 0.00"
    end
    local p = root.Position
    return string.format("X %.2f   Y %.2f   Z %.2f", p.X, p.Y, p.Z),
           string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
end

addConnection(copyBtn.MouseButton1Click:Connect(function()
    local _, raw = coordinateStrings()
    local copied = false
    if type(setclipboard) == "function" then copied = pcall(setclipboard, raw)
    elseif type(toclipboard) == "function" then copied = pcall(toclipboard, raw) end
    if not copied then print("[CYBER PANEL] COORDS:", raw) end
    copyBtn.Text = copied and "ГОТОВО" or "В КОНСОЛИ"
    task.delay(0.7, function()
        if copyBtn and copyBtn.Parent then copyBtn.Text = "КОПИЯ" end
    end)
end))

addConnection(RunService.Stepped:Connect(function()
    if not alive or not state.noclip then return end
    local char = getCharacter()
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollisions[obj] == nil then
                originalCollisions[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end
end))

addConnection(RunService.Heartbeat:Connect(function()
    if not alive or not state.speed then return end
    local humanoid = getHumanoid()
    if humanoid and humanoid.WalkSpeed ~= state.speedValue then
        humanoid.WalkSpeed = state.speedValue
    end
end))

local flyKeys = { W = false, A = false, S = false, D = false, UP = false, DOWN = false }
local keyMap = {
    [Enum.KeyCode.W] = "W",
    [Enum.KeyCode.A] = "A",
    [Enum.KeyCode.S] = "S",
    [Enum.KeyCode.D] = "D",
    [Enum.KeyCode.Space] = "UP",
    [Enum.KeyCode.LeftControl] = "DOWN",
    [Enum.KeyCode.RightControl] = "DOWN",
}

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = keyMap[input.KeyCode]
    if key then flyKeys[key] = true end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    local key = keyMap[input.KeyCode]
    if key then flyKeys[key] = false end
end))

addConnection(RunService.RenderStepped:Connect(function()
    if not alive then return end
    local display = coordinateStrings()
    coordsLabel.Text = display
    if not state.fly then return end
    camera = workspace.CurrentCamera or camera
    local root = getRoot()
    local humanoid = getHumanoid()
    if not root or not humanoid or not camera then return end
    humanoid.PlatformStand = true
    local direction = Vector3.zero
    local cf = camera.CFrame
    if flyKeys.W then direction += cf.LookVector end
    if flyKeys.S then direction -= cf.LookVector end
    if flyKeys.D then direction += cf.RightVector end
    if flyKeys.A then direction -= cf.RightVector end
    if flyKeys.UP then direction += Vector3.yAxis end
    if flyKeys.DOWN then direction -= Vector3.yAxis end
    if direction.Magnitude > 0 then direction = direction.Unit end
    root.AssemblyLinearVelocity = direction * state.flySpeed
    root.AssemblyAngularVelocity = Vector3.zero
end))

addConnection(UserInputService.JumpRequest:Connect(function()
    if not alive or not state.infiniteJump then return end
    local humanoid = getHumanoid()
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end))

addConnection(player.CharacterAdded:Connect(function(char)
    originalWalkSpeed = nil
    table.clear(originalCollisions)
    local humanoid = char:WaitForChild("Humanoid", 10)
    task.wait(0.15)
    if state.speed and humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = state.speedValue
    end
    if state.fly and humanoid then
        humanoid.PlatformStand = true
    end
end))

