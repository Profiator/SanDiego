local function performServerAttack()
    return pcall(function()
        RequestAttack:FireServer()
        PlayerClick:FireServer()
    end)
end

local function performLocalClickFallback()
    local didSomething = false
    if type(mouse1click) == "function" then
        local ok = pcall(mouse1click)
        didSomething = didSomething or ok
    elseif type(mouse1press) == "function" and type(mouse1release) == "function" then
        local ok = pcall(function()
            mouse1press()
            task.wait(0.015)
            mouse1release()
        end)
        didSomething = didSomething or ok
    end
    local char = getCharacter()
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        local ok = pcall(function() tool:Activate() end)
        didSomething = didSomething or ok
    end
    if not didSomething then
        local mouse = UserInputService:GetMouseLocation()
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new())
            task.wait(0.015)
            VirtualUser:Button1Up(Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new())
        end)
    end
end

task.spawn(function()
    while alive do
        if state.autoClick then
            local ok = performServerAttack()
            if not ok then performLocalClickFallback() end
            task.wait(0.05)
        else
            task.wait(0.06)
        end
    end
end)

