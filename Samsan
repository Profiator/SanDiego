		UDim2.new(
			1,
			-30,
			0,
			38
		)

	Кнопка.Position =
		UDim2.fromOffset(
			15,
			Высота
		)

	Кнопка.BackgroundColor3 =
		Color3.fromRGB(
			35,
			36,
			44
		)

	Кнопка.BorderSizePixel = 0

	Кнопка.Text = Текст

	Кнопка.TextColor3 =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Кнопка.Font =
		Enum.Font.GothamMedium

	Кнопка.TextSize = 14

	Кнопка.AutoButtonColor = true

	Кнопка.ZIndex = 21

	Кнопка.Parent =
		Меню


	local Скругление =
		Instance.new("UICorner")

	Скругление.CornerRadius =
		UDim.new(0, 7)

	Скругление.Parent =
		Кнопка


	return Кнопка
