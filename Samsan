                                name = tostring(item.name or ("Локация " .. tostring(i))),
                                pos = Vector3.new(x, y, z),
                                wait = math.clamp(seconds or 2, 0.05, 3600),
                                isChest = item.isChest == true,
                            }
                        end
                    end
                end
                routeData[idx].points = restored
            end
        end
    end

    routeStart = routeData[state.activeRoute].start
    routePoints = routeData[state.activeRoute].points

    return true
end

