local function setTab(name)
    local charActive = name == "CHARACTER"
    characterPage.Visible = charActive
    autofarmPage.Visible = not charActive
    characterTab.BackgroundColor3 = charActive and C.accent or C.panel2
    characterTab.TextColor3 = charActive and C.bg or C.text
    autofarmTab.BackgroundColor3 = not charActive and C.accent or C.panel2
    autofarmTab.TextColor3 = not charActive and C.bg or C.text
end

