local function parseTeleportCoordinates(raw)
    local nums = {}

    for token in string.gmatch(
        tostring(raw or ""),
        "[-+]?%d*%.?%d+"
    ) do
        local n = tonumber(token)

        if n then
            nums[#nums + 1] = n

            if #nums >= 3 then
                break
            end
        end
    end

    if #nums < 3 then
        return nil
    end

    return nums[1], nums[2], nums[3]
end

local function teleportFromInput()
    local x, y, z = parseTeleportCoordinates(tpInput.Text)

    if not x then
        tpInput.Text = ""
        tpInput.PlaceholderText = "ОШИБКА: X, Y, Z"
        return
    end

    local root = getRoot()

    if not root then
        tpInput.PlaceholderText = "ПЕРСОНАЖ НЕ НАЙДЕН"
        return
    end

    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(x, y, z)
    end)

    tpInput.Text = string.format(
        "%.2f, %.2f, %.2f",
        x,
        y,
        z
    )
end

addConnection(
    tpButton.MouseButton1Click:Connect(
        teleportFromInput
    )
)

addConnection(
    tpInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            teleportFromInput()
        end
    end)
)

-- =========================================================
-- CLICK / ATTACK ENGINE
-- =========================================================

-- Из декомпиляции AttackController:
-- RequestAttack:FireServer()
-- PlayerClick:FireServer()
-- task.wait(0.05)
--
-- То есть для настоящей атаки серверу НЕ нужны enemyId/position.
-- Сервер сам выбирает цель.

local function performServerAttack()
    local ok = pcall(function()
        RequestAttack:FireServer()
        PlayerClick:FireServer()
    end)

    return ok
end

-- Локальные fallbacks оставляем только как резерв.
local function performLocalClickFallback()
    local didSomething = false

    if type(mouse1click) == "function" then
        local ok = pcall(mouse1click)
        didSomething = didSomething or ok
    elseif type(mouse1press) == "function"
        and type(mouse1release) == "function"
    then
        local ok = pcall(function()
            mouse1press()
            task.wait(0.015)
            mouse1release()
        end)
        didSomething = didSomething or ok
    end

    local char = getCharacter()
    local tool = char and char:FindFirstChildOfClass("Tool")

    if tool then
        local ok = pcall(function()
            tool:Activate()
        end)
        didSomething = didSomething or ok
    end

    if not didSomething then
        local mouse = UserInputService:GetMouseLocation()

        pcall(function()
            VirtualUser:Button1Down(
                Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new()
            )

            task.wait(0.015)

            VirtualUser:Button1Up(
                Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new()
            )
        end)
    end
end

task.spawn(function()
    while alive do
        if state.autoClick then
            local ok = performServerAttack()

            if not ok then
                performLocalClickFallback()
            end

            task.wait(0.05)
        else
            task.wait(0.06)
        end
    end
end)

