-- =========================================================
-- GAME SCANNER 61–75
-- =========================================================

local scanKeywords = {
    "stage",
    "wave",
    "kill",
    "mob",
    "enemy",
    "trophy",
    "cup",
    "battle",
    "fight",
    "damage",
    "attack",
    "progress",
    "checkpoint",
    "zone",
    "level",
    "next",
}

local function interesting(text)
    text = string.lower(tostring(text or ""))

    for _, key in ipairs(scanKeywords) do
        if string.find(text, key, 1, true) then
            return true
        end
    end

    return false
end

local function fullName(obj)
    local ok, result = pcall(function()
        return obj:GetFullName()
    end)

    return ok and result or tostring(obj)
end

local function scanGame()
    local lines = {}

    local function add(...)
        local parts = {...}
        for i, v in ipairs(parts) do
            parts[i] = tostring(v)
        end

        local line = table.concat(parts, " ")
        table.insert(lines, line)
        print("[CYBER SCAN]", line)
    end

    add("===== PLAYER ATTRIBUTES =====")

    for name, value in pairs(player:GetAttributes()) do
        if interesting(name) then
            add(name, "=", value)
        end
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        add("===== LEADERSTATS =====")

        for _, obj in ipairs(leaderstats:GetChildren()) do
            if interesting(obj.Name) then
                local ok, value = pcall(function()
                    return obj.Value
                end)

                add(obj.Name, "=", ok and value or "?")
            end
        end
    end

    add("===== REMOTES =====")

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local path = fullName(obj)

            if interesting(path) then
                add(
                    "[" .. obj.ClassName .. "]",
                    path
                )
            end
        end
    end

    add("===== NPC / HUMANOIDS =====")

    local npcCount = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") then
            local model = obj.Parent

            if model
                and model:IsA("Model")
                and not isPlayerCharacter(model)
            then
                local r = getMobRoot(model)

                if r and r:IsA("BasePart") then
                    npcCount = npcCount + 1

                    add(
                        model.Name,
                        "HP=" .. tostring(math.floor(obj.Health)),
                        "POS=" ..
                        string.format(
                            "%.1f,%.1f,%.1f",
                            r.Position.X,
                            r.Position.Y,
                            r.Position.Z
                        )
                    )

                    if npcCount >= 80 then
                        add("NPC output limited to 80")
                        break
                    end
                end
            end
        end
    end

    local report = table.concat(lines, "\n")

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, report)
    elseif type(toclipboard) == "function" then
        copied = pcall(toclipboard, report)
    end

    setFarmStatus(
        copied
        and "Скан готов и скопирован. Пришли текст мне."
        or "Скан готов. Скопируй вывод Xeno Console."
    )
end

addConnection(scanBtn.MouseButton1Click:Connect(function()
