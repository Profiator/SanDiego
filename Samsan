local function makeToggle(row, initial, callback)
    local current = initial
    local b = makeButton(row, "", UDim2.new(1, -58, 0.5, -11), UDim2.fromOffset(49, 22))
    local function redraw()
        if current then
            b.BackgroundColor3 = C.green
            b.TextColor3 = C.bg
            b.Text = "ВКЛ"
        else
            b.BackgroundColor3 = C.off
            b.TextColor3 = C.text
            b.Text = "ВЫКЛ"
        end
    end
    addConnection(b.MouseButton1Click:Connect(function()
        current = not current
        redraw()
        callback(current)
    end))
    redraw()
    return b
end

local function makeCompactSlider(parent, y, titleText, minValue, maxValue, initialValue, callback)
    local box = Instance.new("Frame")
    box.Position = UDim2.fromOffset(0, y)
    box.Size = UDim2.new(1, 0, 0, 43)
    box.BackgroundColor3 = C.panel
    box.BackgroundTransparency = 0.08
    box.BorderSizePixel = 0
    box.Parent = parent
    round(box, 7)
    addStroke(box, C.cyanDim, 0.65)

    makeLabel(box, titleText, UDim2.fromOffset(9, 2),
        UDim2.new(1, -55, 0, 17), 16, C.muted, Enum.Font.GothamBold)

    local valueLabel = makeLabel(box, tostring(initialValue),
        UDim2.new(1, -47, 0, 2), UDim2.fromOffset(38, 17),
        17, C.cyan, Enum.Font.Code)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(9, 28)
    track.Size = UDim2.new(1, -18, 0, 4)
    track.BackgroundColor3 = C.off
    track.BorderSizePixel = 0
    track.Parent = box
    round(track, 2)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = C.cyan
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 2)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(9, 9)
    knob.BackgroundColor3 = C.text
    knob.BorderSizePixel = 0
    knob.Parent = track
    round(knob, 5)

    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Position = UDim2.fromOffset(-3, -8)
    hit.Size = UDim2.new(1, 6, 0, 20)
    hit.Parent = track

    local dragging = false

    local function setValue(v)
        v = math.floor(math.clamp(v, minValue, maxValue) + 0.5)
        local alpha = (v - minValue) / math.max(maxValue - minValue, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        callback(v)
    end

    local function setFromX(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        setValue(minValue + (maxValue - minValue) * alpha)
    end

    addConnection(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end))
    addConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end))
    addConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    setValue(initialValue)
end

