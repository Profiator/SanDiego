-- SHUTDOWN
-- =========================================================

local function shutdown()
    if not alive then return end
    alive = false
    state.speed = false
    state.noclip = false
    state.fly = false
    state.autoClick = false
    state.infiniteJump = false
    state.autoRebirth = false
    state.antiAfk = false
    state.routeFarm = false
    routeIndex = 1
    routeStarted = false
    restoreIdleConnections()

    local humanoid = getHumanoid()
    local root = getRoot()
    if humanoid then
        if originalWalkSpeed ~= nil then
            pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
        end
        pcall(function() humanoid.PlatformStand = false end)
    end
    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    for part, oldValue in pairs(originalCollisions) do
        if part and part.Parent then
            pcall(function() part.CanCollide = oldValue end)
        end
    end
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    if gui then gui:Destroy() end
end

