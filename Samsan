local Перетаскивается = false

local НачалоПеретаскивания = nil

local НачальнаяПозицияМеню = nil


Заголовок.InputBegan:Connect(
	function(Ввод)

		if Ввод.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Перетаскивается = true

			НачалоПеретаскивания =
				Ввод.Position

			НачальнаяПозицияМеню =
				Меню.Position

		end
	end
)


UserInputService.InputChanged:Connect(
	function(Ввод)

		if
			Перетаскивается
			and
			Ввод.UserInputType ==
			Enum.UserInputType.MouseMovement
		then

			local Разница =
				Ввод.Position
				-
				НачалоПеретаскивания


			Меню.Position =
				UDim2.new(

					НачальнаяПозицияМеню.X.Scale,

					НачальнаяПозицияМеню.X.Offset
					+
					Разница.X,

					НачальнаяПозицияМеню.Y.Scale,

					НачальнаяПозицияМеню.Y.Offset
					+
					Разница.Y
				)
		end
	end
)


UserInputService.InputEnded:Connect(
	function(Ввод)

		if Ввод.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Перетаскивается = false

		end
	end
)


--============================================================
-- ПОИСК TOOL
--============================================================

local function ПолучитьОружие()

	local Персонаж =
		ЛокальныйИгрок.Character


	if not Персонаж then

		return nil

	end


	for _, Объект in ipairs(
		Персонаж:GetChildren()
	) do

		if Объект:IsA("Tool") then

			return Объект

		end
	end


	return nil
end


--============================================================
-- ПОИСК ТЕКСТА В НАЗВАНИИ ОРУЖИЯ
--============================================================

local function СодержитНазвание(
	Название,
	Список
)

	Название =
		string.lower(
			Название
		)


	for _, Слово in ipairs(
		Список
	) do

		if string.find(
			Название,
			Слово,
			1,
			true
		) then

			return true

		end
	end


	return false
end


--============================================================
-- МОЖНО ЛИ ИСПОЛЬЗОВАТЬ AIM С ТЕКУЩИМ ОРУЖИЕМ
--============================================================

local function ОружиеРазрешено()

	local Оружие =
		ПолучитьОружие()


	-- Если игра использует собственную
	-- систему оружия, а не Tool,
	-- НЕ блокируем AIM.
	if not Оружие then

		return true

	end


	local Название =
		string.lower(
			Оружие.Name
		)


	if СодержитНазвание(
		Название,
		НазванияAWP
	) then

		return
			Настройки.AWPВключен

	end


	if СодержитНазвание(
		Название,
		НазванияПистолетов
	) then

		return
			Настройки.ПистолетВключен

	end


	-- Неизвестное оружие не блокируем.
	return true
end


--============================================================
-- ПОЛУЧЕНИЕ ТОЧКИ НАВЕДЕНИЯ
--============================================================

local function ПолучитьЧастьЦели(
	Персонаж
)

	if Настройки.Цель ==
		"ГОЛОВА" then

		return
			Персонаж:FindFirstChild(
				"Head",
				true
			)

	end


	return

		Персонаж:FindFirstChild(
			"UpperTorso",
			true
		)

		or

		Персонаж:FindFirstChild(
			"Torso",
			true
		)

		or

		Персонаж:FindFirstChild(
			"HumanoidRootPart",
			true
		)

end


--============================================================
-- ПРОВЕРКА ИГРОКА
--============================================================

local function ЦельПодходит(
	Игрок
)

	if Игрок ==
		ЛокальныйИгрок then

		return false

	end


	if Настройки.ПроверятьКоманду then

		if
			ЛокальныйИгрок.Team
			and
			Игрок.Team
			and
			Игрок.Team ==
			ЛокальныйИгрок.Team
		then

			return false

		end
	end


	local Персонаж =
		Игрок.Character


	if not Персонаж then

		return false

	end


	local Гуманоид =
		Персонаж:FindFirstChildOfClass(
			"Humanoid"
		)


	if not Гуманоид then

		return false

	end


	if Гуманоид.Health <= 0 then

		return false

	end


	local ЧастьЦели =
		ПолучитьЧастьЦели(
			Персонаж
		)


	if not ЧастьЦели then

		return false

	end


	return true
end


--============================================================
-- ПРОВЕРКА ВИДИМОСТИ
--============================================================

local function ЦельВидима(
	Персонаж,
	ЧастьЦели
)

	if not Настройки.ПроверятьСтены then

		return true

	end


	local Параметры =
		RaycastParams.new()


	Параметры.FilterType =
		Enum.RaycastFilterType.Exclude


	local Исключения = {}


	if ЛокальныйИгрок.Character then

		table.insert(
			Исключения,
			ЛокальныйИгрок.Character
		)

	end


	Параметры.FilterDescendantsInstances =
		Исключения


	local Начало =
		Камера.CFrame.Position


	local Направление =
		ЧастьЦели.Position
		-
		Начало


	local Результат =
		workspace:Raycast(

			Начало,

			Направление,

			Параметры
		)


	if not Результат then

		return true

	end


	return
		Результат.Instance:IsDescendantOf(
			Персонаж
		)
end


--============================================================
-- ПОИСК БЛИЖАЙШЕЙ ЦЕЛИ ВНУТРИ КРУГА
--============================================================

local function НайтиЦельВКруге()

	Камера =
		workspace.CurrentCamera


	if not Камера then

		return nil

	end


	local РазмерЭкрана =
		Камера.ViewportSize


	local ЦентрЭкрана =
		Vector2.new(

			РазмерЭкрана.X / 2,

			РазмерЭкрана.Y / 2
		)


	local ЛучшаяЦель = nil

	local ЛучшееРасстояние =
		Настройки.Радиус


	for _, Игрок in ipairs(
		Players:GetPlayers()
	) do

		if ЦельПодходит(
			Игрок
		) then


			local Персонаж =
				Игрок.Character


			local ЧастьЦели =
				ПолучитьЧастьЦели(
					Персонаж
				)


			if ЧастьЦели then


				local РасстояниеВМире =
					(
						ЧастьЦели.Position
						-
						Камера.CFrame.Position
					).Magnitude


				if РасстояниеВМире <=
					Настройки.МаксимальнаяДистанция
				then


					local ЭкраннаяПозиция,
						НаЭкране =

						Камера:WorldToViewportPoint(
							ЧастьЦели.Position
						)


					if
						НаЭкране
						and
						ЭкраннаяПозиция.Z > 0
					then


						local Точка =
							Vector2.new(

								ЭкраннаяПозиция.X,

								ЭкраннаяПозиция.Y
							)


						local РасстояниеОтЦентра =
							(
								Точка
								-
								ЦентрЭкрана
							).Magnitude


						-- ВАЖНАЯ ПРОВЕРКА:
						-- цель должна находиться
						-- ВНУТРИ нарисованного круга.
						if
							РасстояниеОтЦентра
							<=
							Настройки.Радиус
							and
							РасстояниеОтЦентра
							<
							ЛучшееРасстояние
						then


							if ЦельВидима(
								Персонаж,
								ЧастьЦели
							) then


								ЛучшееРасстояние =
									РасстояниеОтЦентра


								ЛучшаяЦель =
									Игрок

							end
						end
					end
				end
			end
		end
	end


	return ЛучшаяЦель
end


--============================================================
-- ПРОВЕРКА БИНДА
--============================================================

local function ЭтоНашБинд(
	Ввод
)

	if БиндМыши then

		return
			Ввод.UserInputType ==
			БиндМыши

	end


	if БиндКлавиатуры then

		return
			Ввод.KeyCode ==
			БиндКлавиатуры

	end


	return false
end


--============================================================
-- НАЖАТИЕ КНОПКИ
--============================================================

UserInputService.InputBegan:Connect(
	function(
		Ввод,
		ОбработанИгрой
	)


		--====================================================
		-- НАЗНАЧЕНИЕ НОВОГО БИНДА
		--====================================================

		if ОжиданиеБинда then


			if Ввод.KeyCode ==
				Enum.KeyCode.Escape then

				ОжиданиеБинда = false

				ОбновитьМеню()

				return
			end


			if Ввод.UserInputType ==
				Enum.UserInputType.Keyboard
			then


				if Ввод.KeyCode ~=
					Enum.KeyCode.Unknown
				then

					БиндКлавиатуры =
						Ввод.KeyCode

					БиндМыши = nil

					ОжиданиеБинда =
						false

					ОбновитьМеню()

					return
				end
			end


			if

				Ввод.UserInputType ==
				Enum.UserInputType.MouseButton1

				or

				Ввод.UserInputType ==
				Enum.UserInputType.MouseButton2

				or

				Ввод.UserInputType ==
				Enum.UserInputType.MouseButton3

			then


				БиндМыши =
					Ввод.UserInputType

				БиндКлавиатуры =
					nil

				ОжиданиеБинда =
					false

				ОбновитьМеню()

				return
			end
		end


		-- Если пользователь печатает в TextBox,
		-- AIM не включаем.
		if UserInputService:GetFocusedTextBox() then

			return

		end


		-- ВАЖНО:
		-- специально НЕ используем
		-- "if ОбработанИгрой then return end"
		--
		-- Потому что FPS-игра может сама
		-- помечать ПКМ/ЛКМ как обработанную кнопку,
		-- из-за чего AIM раньше не запускался.


		if ЭтоНашБинд(
			Ввод
		) then


			if not Настройки.AimВключен then

				return

			end


			if not ОружиеРазрешено() then

				Статус.Text =
					"СТАТУС: AIM ДЛЯ ЭТОГО ОРУЖИЯ ВЫКЛ"

				return

			end


			КнопкаЗажата = true


			-- Сразу ищем цель внутри круга.
			ТекущаяЦель =
				НайтиЦельВКруге()


			if ТекущаяЦель then

				Статус.Text =
					"ЦЕЛЬ ЗАХВАЧЕНА: "
					..
					ТекущаяЦель.Name

			else

				Статус.Text =
					"СТАТУС: ИЩУ ЦЕЛЬ В КРУГЕ"

			end

		end
	end
)


--============================================================
-- ОТПУСКАНИЕ КНОПКИ
--============================================================

UserInputService.InputEnded:Connect(
	function(
		Ввод
	)


		if ЭтоНашБинд(
			Ввод
		) then


			КнопкаЗажата = false


			-- Вот здесь цель отпускается.
			ТекущаяЦель = nil


			Статус.Text =
				"СТАТУС: ОЖИДАНИЕ"

		end
	end
)


--============================================================
-- ОСНОВНОЙ ЦИКЛ AIM
--============================================================
--
-- Используем BindToRenderStep с очень высоким приоритетом.
--
-- Это важно для FPS:
-- сначала игра обновляет свою камеру,
-- а ПОТОМ наш AIM корректирует направление камеры.
--
--============================================================

RunService:BindToRenderStep(

	"РусскийAim",

	Enum.RenderPriority.Last.Value - 1,

	function(ДельтаВремени)


		Камера =
			workspace.CurrentCamera


		if not Камера then

			return

		end


		--====================================================
		-- ОБНОВЛЕНИЕ КРУГА
		--====================================================

		local РазмерЭкрана =
			Камера.ViewportSize


		Круг.Position =
			UDim2.fromOffset(

				РазмерЭкрана.X / 2,

				РазмерЭкрана.Y / 2
			)


		Круг.Size =
			UDim2.fromOffset(

				Настройки.Радиус * 2,

				Настройки.Радиус * 2
			)


		Круг.Visible =

			Настройки.AimВключен

			and

			Настройки.ПоказыватьКруг


		--====================================================
		-- AIM НЕ ЗАЖАТ
		--====================================================

		if not КнопкаЗажата then

			return

		end


		if not Настройки.AimВключен then

			КнопкаЗажата = false

			ТекущаяЦель = nil

			return

		end


		if not ОружиеРазрешено() then

			return

		end


		--====================================================
		-- ЕСЛИ ЦЕЛИ НЕТ — ПРОДОЛЖАЕМ ИСКАТЬ
		--====================================================
		--
		-- То есть можно сначала зажать кнопку,
		-- а потом провести прицелом по противнику.
		-- Как только он войдёт в круг,
		-- AIM его захватит.
		--
		--====================================================

		if not ТекущаяЦель then


			ТекущаяЦель =
				НайтиЦельВКруге()


			if ТекущаяЦель then

				Статус.Text =
					"ЦЕЛЬ ЗАХВАЧЕНА: "
					..
					ТекущаяЦель.Name

			else

				Статус.Text =
					"СТАТУС: ИЩУ ЦЕЛЬ В КРУГЕ"

				return

			end
		end


		--====================================================
		-- ПРОВЕРКА, ЖИВА ЛИ ЗАХВАЧЕННАЯ ЦЕЛЬ
		--====================================================

		if not ЦельПодходит(
			ТекущаяЦель
		) then


			ТекущаяЦель = nil


			-- Пока бинд всё ещё зажат,
			-- сразу пытаемся найти следующую цель.
			ТекущаяЦель =
				НайтиЦельВКруге()


			return

		end


		local Персонаж =
			ТекущаяЦель.Character


		if not Персонаж then

			ТекущаяЦель = nil

			return

		end


		local ЧастьЦели =
			ПолучитьЧастьЦели(
				Персонаж
			)


		if not ЧастьЦели then

			ТекущаяЦель = nil

			return

		end


		--====================================================
		-- ВАЖНО:
		--
		-- ЗДЕСЬ МЫ БОЛЬШЕ НЕ ПРОВЕРЯЕМ КРУГ.
		--
		-- Круг используется ТОЛЬКО для
		-- первоначального захвата.
		--
		-- После захвата камера держит этого игрока,
		-- пока ты не отпустишь бинд.
		--====================================================


		local ПозицияКамеры =
			Камера.CFrame.Position


		local НужноеНаправление =
			CFrame.lookAt(

				ПозицияКамеры,

				ЧастьЦели.Position
			)


		-- Плавность с учётом FPS.
		local Коэффициент =

			1

			-

			math.pow(

				1
				-
				math.clamp(
					Настройки.Плавность,
					0.01,
					1
				),

				ДельтаВремени * 60
			)


		Камера.CFrame =
			Камера.CFrame:Lerp(

				НужноеНаправление,

				Коэффициент
			)


		Статус.Text =

			"ДЕРЖУ: "

			..

			ТекущаяЦель.Name

			..

			" → "

			..

			Настройки.Цель

	end
)


--============================================================
-- INSERT — ПОКАЗАТЬ / СКРЫТЬ МЕНЮ
--============================================================

UserInputService.InputBegan:Connect(
	function(
		Ввод
	)

		if Ввод.KeyCode ==
			Enum.KeyCode.Insert
		then

			МенюОткрыто =
				not МенюОткрыто

			Меню.Visible =
				МенюОткрыто

		end
	end
)


--============================================================
-- ЕСЛИ ЗАХВАЧЕННЫЙ ИГРОК ВЫШЕЛ
--============================================================

Players.PlayerRemoving:Connect(
	function(
		Игрок
	)

		if ТекущаяЦель ==
			Игрок
		then

			ТекущаяЦель = nil

		end
	end
)


print(
	"[AIM] Русская система AIM успешно загружена"
)
