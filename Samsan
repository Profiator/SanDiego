	if AimMouseButton == Enum.UserInputType.MouseButton2 then

		return "ПКМ"
	end


	if AimMouseButton == Enum.UserInputType.MouseButton3 then

		return "СКМ"
	end


	if AimKeyCode then

		return AimKeyCode.Name
	end


	return "НЕТ"
end


