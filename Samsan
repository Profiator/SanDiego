-- === ПОЛЁТ (С МАСКИРОВКОЙ) ===
local isFlyEnabled = false
local flyBV, flyBG, flyFloor
local flying = false

local function createFloor()
    if flyFloor and flyFloor.Parent then return end
    flyFloor = Instance.new("Part")
    flyFloor.Name = "InvisibleFloor"
    flyFloor.Size = Vector3.new(12, 1, 12)
    flyFloor.Transparency = 1
    flyFloor.CanCollide = true
    flyFloor.Anchored = true
    flyFloor.Parent = Workspace
end

local function destroyFloor()
    if flyFloor then flyFloor:Destroy(); flyFloor = nil end
end

local function startFly(root)
    if flying then return end
    flying = true
    createFloor()
    flyBG = Instance.new("BodyGyro")
    flyBG.P = 9e5
    flyBG.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.cframe = root.CFrame
    flyBG.Parent = root
    flyBV = Instance.new("BodyVelocity")
    flyBV.velocity = Vector3.new(0,0,0)
    flyBV.maxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = root
end

local function stopFly()
    if not flying then return end
    flying = false
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    destroyFloor()
    local root = getCharRoot(true)
    if root then
        local ray = Ray.new(root.Position, Vector3.new(0, -200, 0))
        local hit, pos = Workspace:FindPartOnRay(ray, root)
        if hit then
            _G.AllowCFrameChange = true
            root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
            _G.AllowCFrameChange = false
        end
    end
end

C(RunService.RenderStepped, function()
    if isFlyEnabled then
        local root = getCharRoot(true)
        if root then
            if not flying or (flyBG and flyBG.Parent ~= root) then
                stopFly()
                startFly(root)
            end
            if flying then
                local cam = Workspace.CurrentCamera
                flyBG.cframe = CFrame.new(cam.CFrame.p, cam.CFrame.p + cam.CFrame.lookVector)
                local dir = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.lookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.rightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                flyBV.velocity = dir.Magnitude > 0 and dir.Unit * 80 or Vector3.new(0,0,0)
                flyFloor.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.5, 0))
                _G.FakeCFrame = CFrame.new(root.Position.X, 0.5, root.Position.Z)
            end
        end
    else
        stopFly()
        if not _G.speedEnabled then _G.FakeCFrame = nil end
    end
end)

-- === СКОРОСТЬ (БЕЗ ПРОВАЛИВАНИЯ) ===
_G.speedEnabled = false
_G.speedValue = 50
_G.AllowSpeedChange = false

local function updateSpeed()
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if not hum then return end
    if _G.speedEnabled and not isFlyEnabled then
        _G.AllowSpeedChange = true
        hum.WalkSpeed = _G.speedValue
        _G.AllowSpeedChange = false
    else
        _G.AllowSpeedChange = true
        hum.WalkSpeed = 16
        _G.AllowSpeedChange = false
    end
end
C(RunService.RenderStepped, function() updateSpeed() end)

