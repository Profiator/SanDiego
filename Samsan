                        target = pos + Vector3.new(0, 10, -38)
                    else
                        target = pos + Vector3.new(0, 0, -7)
                    end

                    pcall(function()
                        root.CFrame = CFrame.new(
                            target,
                            pos
                        )
                    end)
                end

                performServerAttack()

                setFarmStatus(
                    string.format(
