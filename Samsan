local function parseTeleportCoordinates(raw)
    local nums = {}
    for token in string.gmatch(tostring(raw or ""), "[-+]?%d*%.?%d+") do
        local n = tonumber(token)
        if n then
            nums[#nums + 1] = n
            if #nums >= 3 then break end
        end
    end
    if #nums < 3 then return nil end
    return nums[1], nums[2], nums[3]
end

local function teleportFromInput()
    local x, y, z = parseTeleportCoordinates(tpInput.Text)
    if not x then
        tpInput.Text = ""
        tpInput.PlaceholderText = "ОШИБКА: X, Y, Z"
        return
    end
    local root = getRoot()
    if not root then
        tpInput.PlaceholderText = "ПЕРСОНАЖ НЕ НАЙДЕН"
        return
    end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(x, y, z)
    end)
    tpInput.Text = string.format("%.2f, %.2f, %.2f", x, y, z)
end

addConnection(tpButton.MouseButton1Click:Connect(teleportFromInput))
