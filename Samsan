local function updateMenu()

	local profileName = getProfileName()

	local profile = Profiles[profileName]


	AimButton.Text =
		"AIM: "
		..
		(Settings.Enabled and "ВКЛ" or "ВЫКЛ")


	ProfileButton.Text =
		"ПРОФИЛЬ: "
		..
		profileName


	WeaponButton.Text =
		profileName
		..
		": "
		..
		(profile.Enabled and "ВКЛ" or "ВЫКЛ")


	TargetButton.Text =
		"ТОЧКА НАВЕДЕНИЯ: "
		..
		(profile.Target == "HEAD" and "ГОЛОВА" or "ТЕЛО")


	if WaitingForBind then

		BindButton.Text =
			"НАЖМИ НОВУЮ КНОПКУ..."

	else

		BindButton.Text =
			"БИНД: "
			..
			getBindName()
	end


	FovButton.Text =
		"РАДИУС КРУГА: "
		..
		profile.FOV
		..
		" | ЛКМ +20 / ПКМ -20"


	SmoothButton.Text =
		"СКОРОСТЬ: "
		..
		string.format(
			"%.2f",
			profile.Smoothness
		)
		..
		" | ЛКМ + / ПКМ -"


	CircleButton.Text =
		"КРУГ: "
		..
		(Settings.ShowCircle and "ВКЛ" or "ВЫКЛ")


	WallButton.Text =
		"ПРОВЕРКА СТЕН: "
		..
		(Settings.WallCheck and "ВКЛ" or "ВЫКЛ")


	setToggleColor(
		AimButton,
		Settings.Enabled
	)


	setToggleColor(
		WeaponButton,
		profile.Enabled
	)


	setToggleColor(
		CircleButton,
		Settings.ShowCircle
	)


	setToggleColor(
		WallButton,
		Settings.WallCheck
	)
end


