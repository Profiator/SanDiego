--==================================================
-- REFRESH MENU
--==================================================

local function refreshMenu()

	AimToggle.Text =
		"AIM: " .. (Config.Enabled and "ON" or "OFF")

	PistolToggle.Text =
		"PISTOL AIM: " .. (Config.PistolEnabled and "ON" or "OFF")

	AWPToggle.Text =
		"AWP AIM: " .. (Config.AWPEnabled and "ON" or "OFF")

	TargetButton.Text =
		"TARGET: " .. string.upper(Config.AimPart)

	BindButton.Text =
		"BIND: " .. Config.AimKey.Name

	FOVButton.Text =
		"FOV: " .. tostring(Config.FOV)

	SmoothButton.Text =
		"SMOOTH: " .. string.format("%.2f",Config.Smoothness)

	CircleButton.Text =
		"FOV CIRCLE: " .. (Config.ShowFOV and "ON" or "OFF")

	setToggleColor(AimToggle,Config.Enabled)
	setToggleColor(PistolToggle,Config.PistolEnabled)
	setToggleColor(AWPToggle,Config.AWPEnabled)
	setToggleColor(CircleButton,Config.ShowFOV)
end

refreshMenu()

