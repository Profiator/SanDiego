local function syncAllRouteEditors()
    for _, editor in pairs(routeEditors) do
        local data = editor.data
        if data then
            if editor.coordBox and editor.coordBox.Parent then
                local parsed = parseXYZ(editor.coordBox.Text)
                if parsed then data.pos = parsed end
            end
            if editor.waitBox and editor.waitBox.Parent then
                local raw = tostring(editor.waitBox.Text or ""):gsub(",", "."):gsub("%s+", "")
                local seconds = tonumber(raw)
                if seconds then data.wait = math.clamp(seconds, 0.05, 3600) end
            end
            if editor.nameBox and editor.nameBox.Parent and not data.isChest then
                local name = tostring(editor.nameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
                if name ~= "" then data.name = name end
            end
        end
    end
    routeData[state.activeRoute].points = routePoints
    routeData[state.activeRoute].start = routeStart
end

