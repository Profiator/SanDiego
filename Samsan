                if root and lastUnlockedStage and lastUnlockedStage < 75 then
                    local current = root.Position

                    if lastSpawnZ
                        and math.abs(current.Z - lastSpawnZ) < 35
                    then
                        root.CFrame =
                            root.CFrame *
                            CFrame.new(0, 0, -6)
                    end
                end

                task.wait(0.12)
            end
        else
            task.wait(0.10)
        end
