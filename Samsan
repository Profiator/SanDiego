-- ---------------------------------------------------------
-- ADD POINT LOGIC
-- ---------------------------------------------------------

local addPointBusy = false
local lastAddRequestAt = 0

local function scrollToRouteIndex(index)
    task.spawn(function()
        task.wait(0.05)
        pcall(updateCanvas)
        local row = routeRows[index]
        if not row or not row.Parent then return end
        local rowTop = row.AbsolutePosition.Y - routeScroll.AbsolutePosition.Y + routeScroll.CanvasPosition.Y
        local visibleHeight = routeScroll.AbsoluteSize.Y
        local canvasHeight = routeListLayout.AbsoluteContentSize.Y + 12
        local maxY = math.max(0, canvasHeight - visibleHeight)
        routeScroll.CanvasPosition = Vector2.new(0, math.clamp(rowTop - 8, 0, maxY))
    end)
end

local function addNewRoutePoint()
    local now = os.clock()
    if addPointBusy or (now - lastAddRequestAt) < 0.45 then return end
    lastAddRequestAt = now
    addPointBusy = true

    local ok, err = xpcall(function()
        if state.routeFarm then error("Сначала выключи автофарм") end
        local pos = parseXYZ(addCoordBox.Text)
        if not pos then error("Координаты должны быть в формате X, Y, Z") end

        local waitRaw = tostring(addWaitBox.Text or ""):gsub(",", "."):gsub("%s+", "")
        local seconds = tonumber(waitRaw) or 2
        seconds = math.clamp(seconds, 0.05, 120)

        local name = tostring(addNameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Локация " .. tostring(#routePoints + 1) end

        local chestIndex = findChestIndex()
        local insertIndex = chestIndex or (#routePoints + 1)

        local newPoint = {
            name = name,
            pos = Vector3.new(pos.X, pos.Y, pos.Z),
            wait = seconds,
            isChest = false,
        }
        table.insert(routePoints, insertIndex, newPoint)
        routeData[state.activeRoute].points = routePoints
        saveRouteLocal(true)
        if routePoints[insertIndex] ~= newPoint then error("Не удалось вставить точку") end

        rebuildRouteRows()
        scrollToRouteIndex(insertIndex)

        setFarmStatus(string.format(
            "ДОБАВЛЕНО в %s // #%d %s // всего %d",
            routeData[state.activeRoute].title,
            insertIndex, name, #routePoints))

        addPointBtn.Text = "ДОБАВЛЕНО ✓ // #" .. tostring(insertIndex)

        task.delay(0.8, function()
            if addPointBtn and addPointBtn.Parent then
                addPointBtn.Text = "+ ДОБАВИТЬ ЛОКАЦИЮ В АКТИВНЫЙ МАРШРУТ"
            end
            if addNameBox and addNameBox.Parent then addNameBox.Text = "" end
            if addCoordBox and addCoordBox.Parent then addCoordBox.Text = "" end
        end)
    end, function(message) return tostring(message) end)

    addPointBusy = false

    if not ok then
        local message = tostring(err or "неизвестная ошибка"):gsub("\n.*", "")
        setFarmStatus("ОШИБКА ДОБАВЛЕНИЯ // " .. message)
        addPointBtn.Text = "ОШИБКА"
        task.delay(1.0, function()
            if addPointBtn and addPointBtn.Parent then
                addPointBtn.Text = "+ ДОБАВИТЬ ЛОКАЦИЮ В АКТИВНЫЙ МАРШРУТ"
            end
        end)
    end
end

addConnection(addPointBtn.Activated:Connect(function()
    task.spawn(addNewRoutePoint)
end))

addConnection(addCoordBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then task.spawn(addNewRoutePoint) end
end))

