local Player = Players.LocalPlayer

local guiParent
if gethui then
    guiParent = gethui()
else
    guiParent = Player:WaitForChild("PlayerGui")
end

local oldGui = guiParent:FindFirstChild("Arc2playAutoLeaves")
if oldGui then
    oldGui:Destroy()
end

local LeafSim

if getloadedmodules then
    for _, module in ipairs(getloadedmodules()) do
        if module.Name:lower():find("leaf", 1, true) then
            local ok, result = pcall(require, module)

            if ok
                and type(result) == "table"
                and type(result.collect) == "function"
                and type(result.collectMany) == "function"
                and result.folder == workspace:FindFirstChild("Leaves") then

                LeafSim = result
                print("[Arc2play] LeafSim found:", module:GetFullName())
                break
            end
        end
    end
end

