-- ARC2PLAY Auto Event + Auto Sell
-- Для своей игры / тестового place.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local EventShopAction = remotes:WaitForChild("EventShopAction")
local InventoryUpdate = remotes:WaitForChild("InventoryUpdate")
local SlimeReveal = remotes:WaitForChild("SlimeReveal")
local SellSlimeAction = remotes:WaitForChild("SellSlimeAction")

-- Твоё серверное x100-событие.
local EVENT_ID = "SATURN_LUCK_100X_RAINBOW_FOUR_LEAF_CLOVER_MILLIONAIRE"
local EVENT_DURATION = 600 -- 10 минут

local AUTO_EVENT = true
local AUTO_SELL = true

-- Купленных/VIP не продаём.
local KEEP_PURCHASED = true
local KEEP_VIP = true

-- После последнего выпадения ждём, чтобы серия OPEN успела закончиться.
local SELL_DEBOUNCE = 1.5
local SELL_INTERVAL = 0.12

local rarityList = {
    {key="COMUNE",      name="COMMON",    rank=1},
    {key="NON COMUNE",  name="UNCOMMON",  rank=2},
    {key="RARO",        name="RARE",      rank=3},
    {key="EPICO",       name="EPIC",      rank=4},
    {key="LEGGENDARIO", name="LEGENDARY", rank=5},
    {key="MITICO",      name="MYTHIC",    rank=6},
    {key="SECRET",      name="SECRET",    rank=7},
    {key="DIVINO",      name="DIVINE",    rank=8},
    {key="LIMITED",     name="LIMITED",   rank=9},
}

local ranks = {
    ["COMUNE"]=1,["COMMON"]=1,
    ["NON COMUNE"]=2,["UNCOMMON"]=2,
    ["RARO"]=3,["RARE"]=3,
    ["EPICO"]=4,["EPIC"]=4,
    ["LEGGENDARIO"]=5,["LEGENDARY"]=5,
    ["MITICO"]=6,["MYTHIC"]=6,
    ["SECRET"]=7,
    ["DIVINO"]=8,["DIVINE"]=8,
    ["LIMITED"]=9,
}

-- По умолчанию MYTHIC+: Mythic и выше оставляем, всё ниже продаём.
local keepIndex = 6
local latestInventory = {}
local nextEventAt = 0
local eventBusy = false
local selling = false
local revealGeneration = 0

local function getRank(rarity)
    return ranks[string.upper(tostring(rarity or "COMUNE"))] or 1
end

local function shouldKeep(slime)
    if not slime then return true end

    if KEEP_PURCHASED and (
        slime.IsPurchasedSlime == true or
        slime.NoEventCoins == true or
        tostring(slime.PaidItemType or "") == "PurchasedSlime"
    ) then
        return true
    end

    if KEEP_VIP and slime.IsVIP == true then
        return true
    end

    return getRank(slime.Rarity) >= rarityList[keepIndex].rank
end

local function x100IsActive()
    local id = tostring(player:GetAttribute("EventSystemActiveId") or player:GetAttribute("ActiveEventId") or "")
    local luck = tonumber(player:GetAttribute("EventSystemLuckMultiplier") or player:GetAttribute("ActiveEventLuckMultiplier") or 1) or 1
    return id == EVENT_ID and luck >= 100
end

local function buyEvent()
    if not AUTO_EVENT or eventBusy then return end
    eventBusy = true

    local ok, err = pcall(function()
        EventShopAction:FireServer("Activate", EVENT_ID)
    end)

    if ok then
        print("[Arc2play] Event Activate sent:", EVENT_ID)
        nextEventAt = os.clock() + EVENT_DURATION
    else
        warn("[Arc2play] Event error:", err)
        nextEventAt = os.clock() + 5
    end

    task.wait(1)
    eventBusy = false
end

-- Автопокупка: сразу при старте (если x100 не активен), затем каждые 600 сек.
task.spawn(function()
    task.wait(1)

    if x100IsActive() then
        nextEventAt = os.clock() + EVENT_DURATION
        print("[Arc2play] x100 уже активен. Следующая покупка через 10 минут.")
    else
        buyEvent()
    end

    while task.wait(1) do
        if AUTO_EVENT and os.clock() >= nextEventAt then
            buyEvent()
        end
    end
end)

-- Храним последнюю таблицу инвентаря, которую прислал сервер.
InventoryUpdate.OnClientEvent:Connect(function(inventory)
    if type(inventory) == "table" then
        latestInventory = inventory
    end
end)

local function autoSellNow()
    if not AUTO_SELL or selling then return end
    selling = true

    local sellList = {}

    for _, slime in ipairs(latestInventory) do
        if slime and not shouldKeep(slime) then
            local index = tonumber(slime.Index or slime.InventoryIndex)
            if index then
                table.insert(sellList, index)
            end
        end
    end

    print("[Arc2play] AutoSell:", #sellList, "| KEEP", rarityList[keepIndex].name .. "+")

    for _, index in ipairs(sellList) do
        if not AUTO_SELL then break end
        pcall(function()
            SellSlimeAction:FireServer("Sell", index)
        end)
        task.wait(SELL_INTERVAL)
    end

    selling = false
end

-- После последнего SlimeReveal в серии запускаем продажу один раз.
SlimeReveal.OnClientEvent:Connect(function()
    if not AUTO_SELL then return end

    revealGeneration = revealGeneration + 1
    local generation = revealGeneration

    task.delay(SELL_DEBOUNCE, function()
        if generation ~= revealGeneration then return end
        task.wait(0.35) -- ждём свежий InventoryUpdate
        autoSellNow()
    end)
end)

