InventoryUpdate.OnClientEvent:Connect(function(inventory)
    if type(inventory) == "table" then
        latestInventory = inventory
        inventoryVersion = inventoryVersion + 1
        setSellStatus(tr("inventory", #inventory, keptRarityCount()))
    end
end)

local function looksLikeInventory(tbl)
    if type(tbl) ~= "table" then
        return false
    end

    local checked = 0

    for _, item in pairs(tbl) do
        if type(item) == "table" then
            checked = checked + 1

            if item.Rarity ~= nil and
               (item.Index ~= nil or item.InventoryIndex ~= nil) then
                return true
            end

            if checked >= 12 then
                break
            end
        end
    end

    return false
end

local function readUpvalue(fn, index)
    if not debug or type(debug.getupvalue) ~= "function" then
        return nil
    end

    local ok, a, b = pcall(debug.getupvalue, fn, index)

    if not ok then
        return nil
    end

    -- Standard Lua: name, value.
    if b ~= nil then
        return b
    end

    -- Some executors return value only.
    if type(a) ~= "string" then
        return a
    end

    return nil
end

local function getInventoryFromGameConnection()
    if type(getconnections) ~= "function" then
        return nil
    end

    local ok, connections = pcall(getconnections, InventoryUpdate.OnClientEvent)

    if not ok or type(connections) ~= "table" then
        return nil
    end

    for _, connection in ipairs(connections) do
        local fn = connection.Function or connection.Function

        if type(fn) == "function" then
            for i = 1, 20 do
                local value = readUpvalue(fn, i)

                if looksLikeInventory(value) then
                    return value
                end
            end
        end
    end

    return nil
end

local function getCurrentInventory()
    local live = getInventoryFromGameConnection()

    if looksLikeInventory(live) then
        latestInventory = live
        return live
    end

    return latestInventory
end

-- =========================================================
-- AUTO CLOSE SELL WINDOW
-- После автопродажи нажимаем штатную кнопку X окна продажи.
-- Это важно: штатный обработчик не только скрывает окно,
-- но и обновляет блокировку движения/горячую панель.
-- =========================================================

local function closeSellWindow()
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then
        return false
    end

    local mainGameUI = playerGui:FindFirstChild("MainGameUI")
    if not mainGameUI then
        return false
    end

    local sellFrame = mainGameUI:FindFirstChild("SellSlimeFrame")
    if not sellFrame or not sellFrame.Visible then
        return false
    end

    local closeButton = sellFrame:FindFirstChild("Close")

    if closeButton and type(getconnections) == "function" then
        -- Сначала пробуем штатный Activated, как обычное нажатие X.
        for _, signal in ipairs({
            closeButton.Activated,
            closeButton.MouseButton1Click
        }) do
            local ok, connections = pcall(getconnections, signal)

            if ok and type(connections) == "table" then
                for _, connection in ipairs(connections) do
                    local fn = connection.Function

                    if type(fn) == "function" then
                        local callOk = pcall(fn)

                        if callOk then
                            log("Окно продажи закрыто штатной кнопкой X")
                            return true
                        end
                    end
                end
            end
        end
    end

    -- Fallback для Xeno, если Function у connection недоступен.
    sellFrame.Visible = false
    log("Окно продажи скрыто напрямую")
    return true
end

-- =========================================================
-- AUTO SELL
-- =========================================================

local function buildSellList(inventory)
    local result = {}

    if type(inventory) ~= "table" then
        return result
    end

    for _, slime in pairs(inventory) do
        if type(slime) == "table" and not shouldKeep(slime) then
            local index = tonumber(slime.Index or slime.InventoryIndex)

            if index then
                table.insert(result, {
                    index = index,
                    rarity = tostring(slime.Rarity or "?"),
                    name = tostring(slime.Name or slime.ModelName or "Slime"),
                })
            end
        end
    end

    -- Critical fix:
    -- if Index is an array position, deleting high -> low prevents shifts.
    table.sort(result, function(a, b)
        return a.index > b.index
    end)

    return result
end

local function autoSellNow()
    if not AUTO_SELL then
        setSellStatus(tr("auto_sell_off"))
        return
    end

    if selling then
        return
    end

    selling = true

    -- Give the game's own InventoryUpdate a moment to finish.
    task.wait(0.20)

    local inventory = getCurrentInventory()
    local sellList = buildSellList(inventory)

    if #sellList == 0 then
        setSellStatus(tr("nothing_sell", keptRarityCount()))

        closeSellWindow()

        selling = false
        return
    end

    setSellStatus(tr("selling", #sellList))
    log("SELL START:", #sellList, "| keep selected:", keptRarityCount())

    local sold = 0

    for _, item in ipairs(sellList) do
        if not AUTO_SELL then
            break
        end

        local ok, err = pcall(function()
            SellSlimeAction:FireServer("Sell", item.index)
        end)

        if ok then
            sold = sold + 1
            log("SELL", item.index, item.rarity, item.name)
        else
            warn("[Arc2play V2] Sell error:", err)
        end

        task.wait(SELL_INTERVAL)
    end

    task.wait(0.45)

    setSellStatus(tr("sold", sold, keptRarityCount()))

    -- Сразу после продажи закрываем окно "Продать слаймов".
    closeSellWindow()

    selling = false
end

-- Автопродажа строго каждые 20 секунд.
-- Работает только когда переключатель "Автопродажа после фарма" = ВКЛ.
task.spawn(function()
    while task.wait(1) do
        if AUTO_SELL then
            local remaining = AUTO_SELL_EVERY

            while AUTO_SELL and remaining > 0 do
                setSellStatus(tr("next_sell", remaining))

                task.wait(1)
                remaining = remaining - 1
            end

            if AUTO_SELL then
                setSellStatus(tr("sell_starting"))
                autoSellNow()
            end
        else
            task.wait(0.5)
        end
    end
end)

-- =========================================================
-- AUTO EVENT
-- =========================================================

local function requestEventState()
    if os.clock() - lastStateRequest < 0.5 then
        return
    end

    lastStateRequest = os.clock()
    pcall(function()
        EventShopAction:FireServer("RequestState")
    end)
end

local function getEventId()
    return tostring(
        player:GetAttribute("EventSystemActiveId") or
        player:GetAttribute("ActiveEventId") or
        ""
    )
end

local function getEventEndsAt()
    return tonumber(
        player:GetAttribute("EventSystemEndsAt") or
        player:GetAttribute("ActiveEventEndsAt") or
        0
    ) or 0
end

local function remainingSeconds()
    return math.max(0, getEventEndsAt() - os.time())
end

local function targetEventActive()
    return getEventId() == currentEventId() and remainingSeconds() > 0
end

local function anyEventActive()
    return getEventId() ~= "" and remainingSeconds() > 0
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function refreshEventStatus()
    if targetEventActive() then
        setEventStatus(tr("event_active", currentModeName(), formatTime(remainingSeconds())))
    elseif anyEventActive() then
        setEventStatus(tr("waiting_other", formatTime(remainingSeconds())))
    elseif AUTO_EVENT then
        setEventStatus(tr("buying", currentModeName()))
    else
        setEventStatus(tr("auto_buy_off"))
    end
end

local function tryBuyEvent(force)
    if not AUTO_EVENT and not force then
        return
    end

    if eventBusy then return end
    if not force and os.clock() - lastBuyAttempt < BUY_RETRY then return end

    local eventId = currentEventId()
    if eventId == "" then return end

    requestEventState()
    task.wait(0.25)

    if targetEventActive() then
        setEventStatus(tr("event_active", currentModeName(), formatTime(remainingSeconds())))
        return
    end

    if anyEventActive() then
        setEventStatus(tr("waiting_other", formatTime(remainingSeconds())))
        return
    end

    eventBusy = true
    lastBuyAttempt = os.clock()
    setEventStatus(tr("buying", currentModeName()))
    log("ACTIVATE", eventId)

    local ok, err = pcall(function()
        EventShopAction:FireServer("Activate", eventId)
    end)

    if not ok then
        warn("[Arc2play] Event Activate error:", err)
        setEventStatus(tr("activate_error"))
        eventBusy = false
        return
    end

    task.wait(1.0)
    requestEventState()
    task.wait(0.35)

    if targetEventActive() then
        setEventStatus(tr("bought", formatTime(remainingSeconds())))
        log("EVENT ACTIVE:", currentModeName(), formatTime(remainingSeconds()))
    else
        setEventStatus(tr("buy_retry", BUY_RETRY))
        warn("[Arc2play] Activate was sent, but server did not report selected event active.")
    end

    eventBusy = false
end

local function eventAttributeChanged()
    refreshEventStatus()
end

player:GetAttributeChangedSignal("EventSystemActiveId"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("EventSystemEndsAt"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("ActiveEventId"):Connect(eventAttributeChanged)
player:GetAttributeChangedSignal("ActiveEventEndsAt"):Connect(eventAttributeChanged)

task.spawn(function()
    task.wait(0.7)
    requestEventState()
    task.wait(0.5)

    while task.wait(1) do
        if AUTO_EVENT then
            if os.clock() - lastStateRequest >= STATE_REFRESH then
                requestEventState()
            end

            if targetEventActive() then
                setEventStatus(tr("event_active", currentModeName(), formatTime(remainingSeconds())))
            elseif anyEventActive() then
                setEventStatus(tr("waiting_other", formatTime(remainingSeconds())))
            else
                tryBuyEvent(false)
            end
        else
            setEventStatus(tr("auto_buy_off"))
        end
    end
end)

