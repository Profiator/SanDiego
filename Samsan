local function makeButton(text, y)
	local button = Instance.new("TextButton")

	button.Size = UDim2.new(1,-30,0,38)
	button.Position = UDim2.new(0,15,0,y)

	button.BackgroundColor3 = Color3.fromRGB(35,35,42)

	button.Text = text
	button.TextColor3 = Color3.fromRGB(255,255,255)

	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14

	button.BorderSizePixel = 0

	button.ZIndex = 11
	button.Parent = Menu

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,7)
	corner.Parent = button

	return button
end

local function setToggleColor(button, enabled)
	if enabled then
		button.BackgroundColor3 = Color3.fromRGB(35,130,70)
	else
		button.BackgroundColor3 = Color3.fromRGB(120,40,40)
	end
end

