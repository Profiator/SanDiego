local function makeRow(parent, y, titleText, height)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(0, y)
    row.Size = UDim2.new(1, 0, 0, height or 44)
    row.BackgroundColor3 = C.panel
    row.BackgroundTransparency = 0.09
    row.BorderSizePixel = 0
    row.Parent = parent
    round(row, 8)
    stroke(row, C.strokeDim, 0.63)

    label(row, titleText, UDim2.fromOffset(12, 0), UDim2.new(1, -100, 1, 0), 11, C.text, Enum.Font.GothamMedium)
    return row
end

local function makeToggle(row, initial, callback)
    local current = initial
    local b = button(row, "", UDim2.new(1, -72, 0.5, -13), UDim2.fromOffset(60, 26))

    local function draw()
        if current then
            b.BackgroundColor3 = C.green
            b.TextColor3 = C.bg
            b.Text = "ON"
        else
            b.BackgroundColor3 = C.off
            b.TextColor3 = C.text
            b.Text = "OFF"
        end
    end

    addConnection(b.MouseButton1Click:Connect(function()
        current = not current
        draw()
        callback(current)
    end))

    draw()
    return b
end

local function makeSlider(parent, y, titleText, minValue, maxValue, initialValue, callback)
    local holder = Instance.new("Frame")
    holder.Position = UDim2.fromOffset(0, y)
    holder.Size = UDim2.new(1, 0, 0, 58)
    holder.BackgroundColor3 = C.panel
    holder.BackgroundTransparency = 0.09
    holder.BorderSizePixel = 0
    holder.Parent = parent
    round(holder, 8)
    stroke(holder, C.strokeDim, 0.63)

    label(holder, titleText, UDim2.fromOffset(12, 5), UDim2.new(1, -94, 0, 22), 10, C.muted, Enum.Font.GothamBold)

    local valueLabel = label(holder, tostring(initialValue), UDim2.new(1, -68, 0, 5), UDim2.fromOffset(56, 22), 10, C.accent, Enum.Font.Code)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(12, 36)
    track.Size = UDim2.new(1, -24, 0, 6)
    track.BackgroundColor3 = C.off
    track.BorderSizePixel = 0
    track.Parent = holder
    round(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, 3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(12, 12)
    knob.BackgroundColor3 = C.text
    knob.BorderSizePixel = 0
    knob.Parent = track
    round(knob, 6)

    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Position = UDim2.fromOffset(-4, -10)
    hit.Size = UDim2.new(1, 8, 0, 26)
    hit.Parent = track

    local dragging = false

    local function setValue(v)
        v = math.floor(math.clamp(v, minValue, maxValue) + 0.5)
        local alpha = (v - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        callback(v)
    end

    local function updateFromX(x)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        setValue(minValue + (maxValue - minValue) * alpha)
    end

    addConnection(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end))

    addConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end))

    addConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    setValue(initialValue)
end

local speedRow = makeRow(characterPage, 0, "WALK SPEED")
makeToggle(speedRow, false, function(v)
    state.speed = v
    local humanoid = getHumanoid()
    if not humanoid then return end

    if v then
        if originalWalkSpeed == nil then originalWalkSpeed = humanoid.WalkSpeed end
        humanoid.WalkSpeed = state.speedValue
    else
        if originalWalkSpeed ~= nil then humanoid.WalkSpeed = originalWalkSpeed end
    end
end)

makeSlider(characterPage, 50, "SPEED VALUE", 16, 250, state.speedValue, function(v)
    state.speedValue = v
    if state.speed then
        local humanoid = getHumanoid()
        if humanoid then humanoid.WalkSpeed = v end
    end
end)

local noclipRow = makeRow(characterPage, 114, "NOCLIP // THROUGH WALLS")
makeToggle(noclipRow, false, function(v)
    state.noclip = v
    if not v then
        for part, oldValue in pairs(originalCollisions) do
            if part and part.Parent then
                pcall(function() part.CanCollide = oldValue end)
            end
        end
        table.clear(originalCollisions)
    end
end)

local flyRow = makeRow(characterPage, 164, "FLY // WASD + SPACE / CTRL")
makeToggle(flyRow, false, function(v)
    state.fly = v
    local humanoid = getHumanoid()
    local root = getRoot()
    if humanoid then humanoid.PlatformStand = v end
    if not v and root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end)

makeSlider(characterPage, 214, "FLY SPEED", 10, 300, state.flySpeed, function(v)
    state.flySpeed = v
end)

local clickRow = makeRow(characterPage, 278, "AUTO CLICK // LEFT MOUSE")
makeToggle(clickRow, false, function(v) state.autoClick = v end)

local jumpRow = makeRow(characterPage, 328, "INFINITE JUMP")
makeToggle(jumpRow, false, function(v) state.infiniteJump = v end)

