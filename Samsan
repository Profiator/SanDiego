local function getRebirthProgressLabel()
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    if not screenGui then return nil end
    local leftSide = screenGui:FindFirstChild("LeftSide")
    local container = leftSide and leftSide:FindFirstChild("Container")
    local menuButtons = container and container:FindFirstChild("MenuButtons")
    local rebirth = menuButtons and menuButtons:FindFirstChild("Rebirth")
    local progress = rebirth and rebirth:FindFirstChild("Progress")
    if progress and progress:IsA("TextLabel") then return progress end
    return nil
end

local function parseProgressPercent(textValue)
    local numberText = tostring(textValue or ""):match("([%d%.]+)%s*%%")
    local value = tonumber(numberText)
    if not value then return nil end
    return value
end

local lastRebirthAttempt = 0
local rebirthBusy = false
local rebirthArmed = true
local rebirthSuccessCount = 0

local function callRequestRebirth()
    if rebirthBusy or not state.autoRebirth then return end
    if os.clock() - lastRebirthAttempt < 1.0 then return end
    rebirthBusy = true
    lastRebirthAttempt = os.clock()
    setAutoStatus("100% // RequestRebirth:InvokeServer()...")
    task.spawn(function()
        local ok, success, message = pcall(function()
            return RequestRebirth:InvokeServer()
        end)
        if not ok then
            setAutoStatus("REBIRTH ERROR // " .. tostring(success))
            rebirthBusy = false
            return
        end
        if success then
            rebirthSuccessCount += 1
            rebirthArmed = false
            setAutoStatus("ПЕРЕРОЖДЕНИЕ ✓ // #" .. tostring(rebirthSuccessCount))
        else
            setAutoStatus("REBIRTH ОТКЛОНЁН // " .. tostring(message or "без сообщения"))
        end
        task.wait(0.60)
        rebirthBusy = false
    end)
end

task.spawn(function()
    while alive do
        if not state.autoRebirth then
            task.wait(0.40)
            continue
        end
        local progress = getRebirthProgressLabel()
        if not progress then
            setAutoStatus(state.antiAfk and "Progress не найден // Anti-AFK активен" or "Progress не найден")
            task.wait(0.50)
            continue
        end
        local percent = parseProgressPercent(progress.Text)
        if not percent then
            setAutoStatus("Progress: " .. tostring(progress.Text))
            task.wait(0.35)
            continue
        end
        if percent < 100 then
            rebirthArmed = true
            setAutoStatus(string.format("REBIRTH %d%% // ждём 100%%%s",
                math.floor(percent), state.antiAfk and " // Anti-AFK" or ""))
        elseif rebirthArmed and not rebirthBusy then
            callRequestRebirth()
        else
            setAutoStatus("100% // ждём сброс после перерождения")
        end
        task.wait(0.15)
    end
end)

