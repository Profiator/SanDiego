local function requestEventState()
    if os.clock() - lastStateRequest < 0.5 then
        return
    end

    lastStateRequest = os.clock()

    pcall(function()
        EventShopAction:FireServer("RequestState")
    end)
end

local function getEventId()
    return tostring(
        player:GetAttribute("EventSystemActiveId") or
        player:GetAttribute("ActiveEventId") or
        ""
    )
end

local function getEventEndsAt()
    return tonumber(
        player:GetAttribute("EventSystemEndsAt") or
        player:GetAttribute("ActiveEventEndsAt") or
        0
    ) or 0
end

local function remainingSeconds()
    return math.max(0, getEventEndsAt() - os.time())
end

local function targetEventActive()
    return getEventId() == EVENT_ID and remainingSeconds() > 0
end

local function anyEventActive()
    return getEventId() ~= "" and remainingSeconds() > 0
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function tryBuyEvent(force)
    if not AUTO_EVENT and not force then
        return
    end

    if eventBusy then
        return
    end

    if not force and os.clock() - lastBuyAttempt < BUY_RETRY then
        return
    end

    requestEventState()
    task.wait(0.25)

    if targetEventActive() then
        setEventStatus("MAGIC x3 активно: " .. formatTime(remainingSeconds()))
        return
    end

    if anyEventActive() then
        setEventStatus(
            "Ждём другое событие: " ..
            formatTime(remainingSeconds())
        )
        return
    end

    eventBusy = true
    lastBuyAttempt = os.clock()

    setEventStatus("Покупаем MAGIC LUCK x3...")
    log("ACTIVATE", EVENT_ID)

    local ok, err = pcall(function()
        EventShopAction:FireServer("Activate", EVENT_ID)
    end)

    if not ok then
        warn("[Arc2play V2] Event Activate error:", err)
        setEventStatus("Ошибка отправки Activate")
        eventBusy = false
        return
    end

    -- Let server process purchase, then request authoritative state again.
    task.wait(1.0)
    requestEventState()
    task.wait(0.35)

    if targetEventActive() then
        setEventStatus("КУПЛЕНО • " .. formatTime(remainingSeconds()))
        log("EVENT ACTIVE:", formatTime(remainingSeconds()))
    else
        setEventStatus(
            "Не купилось — повтор через " ..
            tostring(BUY_RETRY) .. " сек"
        )
        warn(
            "[Arc2play V2] Activate was sent, but server did not report the target event active."
        )
    end

    eventBusy = false
end

