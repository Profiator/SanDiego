--========================================================
-- ОСНОВНОЙ AIM
--========================================================
--
-- RenderPriority.Last используется специально:
-- обычная камера Roblox и большинство FPS-камер
-- обновляются раньше, после чего AIM задаёт
-- конечное направление камеры.
--
--========================================================

RunService:BindToRenderStep(

	"ClientAimFinalCamera",

	Enum.RenderPriority.Last.Value,

	function(dt)


		Camera =
			workspace.CurrentCamera


		if not Camera then

			return
		end


		local profile =
			getProfile()


		--================================================
		-- ОБНОВЛЕНИЕ КРУГА
		--================================================

		local viewport =
			Camera.ViewportSize


		FovCircle.Position =
			UDim2.fromOffset(
				viewport.X / 2,
				viewport.Y / 2
			)


		FovCircle.Size =
			UDim2.fromOffset(
				profile.FOV * 2,
				profile.FOV * 2
			)


		FovCircle.Visible =

			Settings.Enabled

			and Settings.ShowCircle

			and profile.Enabled


		--================================================
		-- БИНД НЕ ЗАЖАТ
		--================================================

		if not AimHeld then

			return
		end


		if not Settings.Enabled
			or not profile.Enabled then

			return
		end


		--================================================
		-- ЕСЛИ ЦЕЛИ НЕТ, ПРОДОЛЖАЕМ ИСКАТЬ
		--================================================
		--
		-- Можно сначала зажать кнопку,
		-- затем провести кругом по противнику.
		--
		--================================================

		if not LockedPlayer then


			LockedPlayer =
				findTargetInCircle()


			if not LockedPlayer then

				Status.Text =
					"ИЩУ ЦЕЛЬ В КРУГЕ"

				return
			end


			Status.Text =
				"ЗАХВАЧЕН: "
				..
				LockedPlayer.Name
		end


		--================================================
		-- ЦЕЛЬ УМЕРЛА
		--================================================

		if not validPlayer(
			LockedPlayer
		) then


			LockedPlayer = nil


			Status.Text =
				"ИЩУ СЛЕДУЮЩУЮ ЦЕЛЬ"


			return
		end


		local character =
			LockedPlayer.Character


		local aimPart =
			getAimPart(character)


		if not aimPart then

			LockedPlayer = nil

			return
		end


		--================================================
		-- ВАЖНО
		--
		-- Здесь НЕТ проверки FOV.
		--
		-- Поэтому после захвата цель может
		-- выйти из круга, но AIM продолжит
		-- держать её, пока ты не отпустишь бинд.
		--================================================


		local cameraPosition =
			Camera.CFrame.Position


		local desiredCamera =
			CFrame.lookAt(
				cameraPosition,
				aimPart.Position
			)


		local smooth =
			math.clamp(
				profile.Smoothness,
				0.01,
				1
			)


		local alpha =
			1
			-
			math.pow(
				1 - smooth,
				dt * 60
			)


		Camera.CFrame =
			Camera.CFrame:Lerp(
				desiredCamera,
				alpha
			)


		Status.Text =
			"ДЕРЖУ: "
			..
			LockedPlayer.Name
			..
			" → "
			..
			(
				profile.Target == "HEAD"
				and "ГОЛОВА"
				or "ТЕЛО"
			)
	end
)


--========================================================
-- ИГРОК ВЫШЕЛ
--========================================================

Players.PlayerRemoving:Connect(function(player)

	if LockedPlayer == player then

		LockedPlayer = nil
