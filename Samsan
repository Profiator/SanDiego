local function makeToggle(row, initial, onChange)
    local state = initial
    local b = Instance.new("TextButton")
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = UDim2.new(1, -10, 0.5, 0)
    b.Size = UDim2.fromOffset(70, 28)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.Parent = row

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = b

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(100, 100, 100)
    stroke.Thickness = 1
    stroke.Parent = b

    local function draw()
        if state then
            b.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            b.TextColor3 = Color3.fromRGB(8, 8, 8)
            b.Text = tr("on")
        else
            b.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
            b.TextColor3 = Color3.fromRGB(200, 200, 200)
            b.Text = tr("off")
        end
    end

    b.MouseButton1Click:Connect(function()
        state = not state
        draw()
        onChange(state)
    end)

    table.insert(toggleDrawers, draw)
    draw()
    return b
end

