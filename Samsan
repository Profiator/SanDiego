connectSignal(RunService.Heartbeat, function()
    if isAutoFlip then
        local car = getCar()
        if car and car.PrimaryPart then
            if car.PrimaryPart.Orientation.X > 90 or car.PrimaryPart.Orientation.X < -90 or car.PrimaryPart.Orientation.Z > 90 or car.PrimaryPart.Orientation.Z < -90 then
                local fixCFrame = CFrame.new(car.PrimaryPart.Position) * CFrame.Angles(0, car.PrimaryPart.Orientation.Y, 0)
                car:PivotTo(fixCFrame)
            end
        end
    end
end)

