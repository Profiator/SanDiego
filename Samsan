local function getRarityInfo(key)
    for _, info in ipairs(rarityList) do
        if info.key == key then return info end
    end
end

local function drawRarityCheckbox(key)
    local button = rarityButtons[key]
    if not button then return end
    local info = getRarityInfo(key)
    local name = info and rarityName(info) or key

    if keepRarities[key] == true then
        button.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
        button.TextColor3 = Color3.fromRGB(8, 8, 8)
        button.Text = "✓  " .. name
    else
        button.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
        button.TextColor3 = Color3.fromRGB(205, 205, 205)
        button.Text = "□  " .. name
    end
end

for order, info in ipairs(rarityList) do
    local b = Instance.new("TextButton")
    b.LayoutOrder = order
    b.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.Parent = grid

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = b

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 60)
    stroke.Thickness = 1
    stroke.Transparency = 0.2
    stroke.Parent = b

    rarityButtons[info.key] = b
    drawRarityCheckbox(info.key)

    b.MouseButton1Click:Connect(function()
        keepRarities[info.key] = not (keepRarities[info.key] == true)
        drawRarityCheckbox(info.key)
        local name = rarityName(info)
        setSellStatus(keepRarities[info.key] and tr("keep", name) or tr("sell", name))
    end)
end

