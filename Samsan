-- === УЛЬТРА-АНТИЧИТ (ПЕРЕХВАТ МЕТАТАБЛИЦ) ===
pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall, oldIndex, oldNewIndex = mt.__namecall, mt.__index, mt.__newindex
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            if method == "Kick" or method == "kick" or method == "Teleport" or method == "TeleportToPlaceInstance" then return nil end
            if method == "FireServer" or method == "InvokeServer" then
                local n = tostring(self):lower()
                if n:find("ban") or n:find("kick") or n:find("punish") or n:find("cheat") or n:find("log") or n:find("detect") or n:find("anticheat") or n:find("report") or n:find("crash") or n:find("error") or n:find("suspicious") or n:find("exploit") or n:find("admin") or n:find("kill") or n:find("remove") or n:find("script") then return nil end
            end
            if method == "Destroy" and self:IsA("Tool") and self.Parent and self.Parent == LocalPlayer.Character then
                return nil
            end
            if method == "FindFirstChild" or method == "FindFirstChildOfClass" or method == "FindFirstChildWhichIsA" then
                local args = {...}
                if type(args[1]) == "string" then
                    local x = tostring(args[1])
                    if x:find("BodyVelocity") or x:find("BodyGyro") or x:find("BodyForce") or x:find("AlignPosition") or x:find("LinearVelocity") then
                        local lp = Players.LocalPlayer
                        if lp and lp.Character and self:IsDescendantOf(lp.Character) then return nil end
                    end
                end
            end
            if method == "TakeDamage" and self:IsA("Humanoid") and self.Parent == LocalPlayer.Character then
                return nil
            end
            if method == "GetAttribute" or method == "GetPropertyChangedSignal" then
                local n = tostring(self):lower()
                if n:find("velocity") or n:find("speed") or n:find("health") or n:find("jumppower") then return nil end
            end
        end
        return oldNamecall(self, ...)
    end)

    mt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if key == "WalkSpeed" then return 16 end
            if key == "JumpPower" then return 50 end
            if key == "JumpHeight" then return 7.2 end
            if key == "Transparency" and self:IsA("BasePart") then return 0 end
            if key == "AssemblyLinearVelocity" and self:IsA("BasePart") then return Vector3.new(0,0,0) end
            if key == "CFrame" and typeof(self) == "Instance" and self:IsA("HumanoidRootPart") then
                if _G.FakeCFrame and self == LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return _G.FakeCFrame end
            end
            if key == "Health" and self:IsA("Humanoid") and self.Parent == LocalPlayer.Character then return 100 end
        end
        return oldIndex(self, key)
    end)

    mt.__newindex = newcclosure(function(self, key, value)
        if not checkcaller() then
            if key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" then
                if not _G.AllowSpeedChange then return end
            end
            if key == "AssemblyLinearVelocity" or key == "Velocity" then return end
            if key == "CFrame" and typeof(self) == "Instance" and self:IsA("HumanoidRootPart") then
                if not _G.AllowCFrameChange then return end
            end
            if key == "Health" and self:IsA("Humanoid") and self.Parent == LocalPlayer.Character then
                if not _G.AllowHealthChange then return end
            end
        end
        return oldNewIndex(self, key, value)
    end)

    setreadonly(mt, true)

    local ScriptContext, LogService = game:GetService("ScriptContext"), game:GetService("LogService")
    for _, conn in ipairs(getconnections(ScriptContext.Error)) do conn:Disable() end
    for _, conn in ipairs(getconnections(LogService.MessageOut)) do conn:Disable() end

    pcall(function() for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do if conn.Disable then conn:Disable() end end end)
    pcall(function() if hookfunction then hookfunction(LocalPlayer.Kick, function() return nil end) else LocalPlayer.Kick = function() return nil end end end)
end)

-- === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ===
local function getCharRoot(preferVehicle)
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChild("Humanoid")
    if preferVehicle and hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local veh = hum.SeatPart:FindFirstAncestorWhichIsA("Model")
        if veh and veh.PrimaryPart then return veh.PrimaryPart end
        return hum.SeatPart
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getCar()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then return hum.SeatPart:FindFirstAncestorWhichIsA("Model") end
    end
    return nil
end

