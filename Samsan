local powerRequestCount = 0
local damageRequestCount = 0

local function firePowerRequests(count)
    count = math.clamp(math.floor(tonumber(count) or 1), 1, 10)
    for i = 1, count do
        PlayerClick:FireServer()
        powerRequestCount += 1
        if i < count then task.wait(0.008) end
    end
end

local function fireDamageRequests(count)
    count = math.clamp(math.floor(tonumber(count) or 1), 1, 10)
    for i = 1, count do
        RequestAttack:FireServer()
        damageRequestCount += 1
        if i < count then task.wait(0.008) end
    end
end

local function performServerAttack()
    return pcall(function()
        fireDamageRequests(state.damageMultiplier)
        firePowerRequests(state.powerMultiplier)
    end)
end

addConnection(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    task.spawn(function()
        pcall(function()
            local extraDamage = math.max(0, state.damageMultiplier - 1)
            local extraPower = math.max(0, state.powerMultiplier - 1)
            if extraDamage > 0 then fireDamageRequests(extraDamage) end
            if extraPower > 0 then firePowerRequests(extraPower) end
        end)
    end)
end))

local function performLocalClickFallback()
    local didSomething = false
    if type(mouse1click) == "function" then
        local ok = pcall(mouse1click)
        didSomething = didSomething or ok
    elseif type(mouse1press) == "function" and type(mouse1release) == "function" then
        local ok = pcall(function()
            mouse1press(); task.wait(0.015); mouse1release()
        end)
        didSomething = didSomething or ok
    end
    local char = getCharacter()
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        local ok = pcall(function() tool:Activate() end)
        didSomething = didSomething or ok
    end
    if not didSomething then
        local mouse = UserInputService:GetMouseLocation()
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new())
            task.wait(0.015)
            VirtualUser:Button1Up(Vector2.new(mouse.X, mouse.Y),
                camera and camera.CFrame or CFrame.new())
        end)
    end
end

task.spawn(function()
    while alive do
        if state.autoClick then
            local ok = performServerAttack()
            if not ok then performLocalClickFallback() end
            task.wait(0.05)
        else
            task.wait(0.06)
        end
    end
end)

task.spawn(function()
    while alive do
        if powerStatusLabel and powerStatusLabel.Parent then
            powerStatusLabel.Text = string.format(
                "МОЩЬ: x%d // PlayerClick отправлено: %d",
                state.powerMultiplier, powerRequestCount)
