--========================================================

local function containsName(name, list)

	name = string.lower(name)

	for _, word in ipairs(list) do

		if string.find(name, word, 1, true) then

			return true
		end
	end

	return false
end


local function getProfileName()

	if Settings.AutoWeapon then

		local character = LocalPlayer.Character

		if character then

			local tool = character:FindFirstChildOfClass("Tool")

			if tool then

				if containsName(tool.Name, AWPNames) then

					return "AWP"
				end


				if containsName(tool.Name, PistolNames) then

					return "PISTOL"
				end
			end
		end
	end


	return Settings.CurrentProfile
end


local function getProfile()

	return Profiles[getProfileName()]
end


