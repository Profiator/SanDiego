        if damageStatusLabel and damageStatusLabel.Parent then
            damageStatusLabel.Text = string.format(
                "УРОН: x%d // RequestAttack отправлено: %d",
                state.damageMultiplier, damageRequestCount)
        end
        task.wait(0.5)
    end
end)

