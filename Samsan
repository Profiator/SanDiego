local isInfJump, isNoClip, isAutoFlip = false, false, false
C(UserInputService.JumpRequest, function()
    if isInfJump then local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
end)
C(RunService.Stepped, function()
    if isNoClip and LocalPlayer.Character then for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
end)
C(RunService.Heartbeat, function()
    if isAutoFlip then
        local car = getCar()
        if car and car.PrimaryPart and (car.PrimaryPart.Orientation.X > 90 or car.PrimaryPart.Orientation.X < -90 or car.PrimaryPart.Orientation.Z > 90 or car.PrimaryPart.Orientation.Z < -90) then
            car:PivotTo(CFrame.new(car.PrimaryPart.Position) * CFrame.Angles(0, car.PrimaryPart.Orientation.Y, 0))
        end
    end
end)

-- === УЛУЧШЕННЫЙ AIMBOT (НАВЕДЕНИЕ НА ГОЛОВУ) ===
local isAimbotEnabled, aimTarget, aimStrength = false, nil, 0.9
local function getClosestPlayer()
    local cam = Workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local closest, minDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local sp, on = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < minDist then minDist, closest = d, plr end
                end
            end
        end
    end
    return closest
end
C(RunService.RenderStepped, function()
    if isAimbotEnabled then
        aimTarget = getClosestPlayer()
        if aimTarget and aimTarget.Character then
            local head = aimTarget.Character:FindFirstChild("Head") or aimTarget.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local root = getCharRoot(true)
                if root then
                    _G.AllowCFrameChange = true
                    local targetCF = CFrame.new(root.Position, head.Position + Vector3.new(0, 0.7, 0))
                    root.CFrame = root.CFrame:Lerp(targetCF, aimStrength)
                    _G.AllowCFrameChange = false
                end
            end
        end
    end
end)

