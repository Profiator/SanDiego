        local now = os.clock()
        if boostState.raceMode
           and key == boostState.watchedKey
           and (now - boostState.lastUpdateAt) < 1.5 then
            local prev = boostState.activeBoosts[key]
            if prev and count == prev then
                boostState.raceSuccessCount += 1
                print("[BOOSTS] RACE OK // count остался:", count)
            elseif prev and count and count < prev then
                boostState.raceFailCount += 1
                print("[BOOSTS] RACE FAIL // списано:", prev, "→", count)
            end
        end
        boostState.lastUpdateAt = now
        if count and count > 0 then
            boostState.lastKnownOwned[key] = count
        else
            boostState.lastKnownOwned[key] = nil
        end
    end))
end

