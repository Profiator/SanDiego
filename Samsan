local function syncAllRouteEditors()
    for _, editor in pairs(routeEditors) do
        local data = editor.data
        if data then
            if editor.coordBox and editor.coordBox.Parent then
                local parsed = parseXYZ(editor.coordBox.Text)
                if parsed then data.pos = parsed end
            end
            if editor.waitBox and editor.waitBox.Parent then
                local raw = tostring(editor.waitBox.Text or ""):gsub(",", "."):gsub("%s+", "")
                local seconds = tonumber(raw)
                if seconds then data.wait = math.clamp(seconds, 0.05, 3600) end
            end
            if editor.nameBox and editor.nameBox.Parent and not data.isChest then
                local name = tostring(editor.nameBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
                if name ~= "" then data.name = name end
            end
        end
    end
    saveRouteLocal(true)
end

-- =========================================================
-- ROUTE FARM ENGINE
-- =========================================================

local routeIndex = 1
local routeStarted = false

local function hardTeleport(pos)
    local root = getRoot()
    if not root or typeof(pos) ~= "Vector3" then return false end
    return pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(pos)
        task.wait()
        root.CFrame = CFrame.new(pos)
    end)
end

local function holdPosition(pos, seconds, titleText)
    local duration = math.max(0.05, tonumber(seconds) or 0.05)
    local startedAt = os.clock()
    while alive and state.routeFarm do
        local elapsed = os.clock() - startedAt
        if elapsed >= duration then break end
        local root = getRoot()
        if root then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(pos)
            end)
        end
        local remaining = math.max(0, duration - elapsed)
        setFarmStatus(string.format(
            "%s // %.1f / %.1f сек // осталось %.1f",
            titleText, elapsed, duration, remaining))
        task.wait(0.05)
    end
end

local function goHome()
    syncStartFromBox()
    setFarmStatus("TP ДОМОЙ...")
    hardTeleport(routeStart)
    holdPosition(routeStart, 0.60, "ДОМА")
    return state.routeFarm
end

local function processCurrentPoint()
    syncAllRouteEditors()
    if #routePoints == 0 then
        setFarmStatus("Нет точек")
        state.routeFarm = false
        return
    end
    if routeIndex < 1 or routeIndex > #routePoints then routeIndex = 1 end
    local data = routePoints[routeIndex]
    if not data then routeIndex = 1; return end

    if data.isChest then
        setFarmStatus("СУНДУК // TP...")
        hardTeleport(data.pos)
        holdPosition(data.pos, data.wait, "СУНДУК // забираем")
        if not state.routeFarm then return end
        setFarmStatus("СУНДУК ЗАБРАН ✓ // ДОМОЙ")
        if not goHome() then return end
        routeIndex = 1
        setFarmStatus("НОВЫЙ КРУГ ✓ // точка 1")
        task.wait(0.12)
        return
    end

    setFarmStatus("ТОЧКА " .. tostring(routeIndex) .. "/" .. tostring(#routePoints))
    hardTeleport(data.pos)
    holdPosition(data.pos, data.wait, "ТОЧКА " .. tostring(routeIndex))

    if state.routeFarm then
        routeIndex += 1
        if routeIndex > #routePoints then
            goHome()
            routeIndex = 1
        end
    end
end

task.spawn(function()
    while alive do
        if not state.routeFarm then
            routeStarted = false
            routeIndex = 1
            task.wait(0.10)
            continue
        end
        if #routePoints == 0 then
            state.routeFarm = false
            setFarmStatus("Нет точек в маршруте")
            task.wait(0.20)
            continue
        end
        if not routeStarted then
            routeStarted = true
            routeIndex = 1
            setFarmStatus("ЗАПУСК // TP ДОМОЙ")
            if not goHome() then routeStarted = false; continue end
            setFarmStatus("СТАРТ ✓ // точка 1")
            task.wait(0.12)
        end
        processCurrentPoint()
        task.wait(0.03)
    end
end)

