    local state = initial

    local b = Instance.new("TextButton")
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = UDim2.new(1, -10, 0.5, 0)
    b.Size = UDim2.fromOffset(62, 27)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Parent = row

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = b

    local function draw()
        if state then
            b.BackgroundColor3 = Color3.fromRGB(42, 190, 85)
            b.Text = "ВКЛ"
        else
            b.BackgroundColor3 = Color3.fromRGB(65, 67, 76)
            b.Text = "ВЫКЛ"
        end
    end

    b.MouseButton1Click:Connect(function()
        state = not state
        draw()
        onChange(state)
    end)

    draw()
end

