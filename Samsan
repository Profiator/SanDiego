end))


-- =========================================================
-- AUTO PLAYTIME REWARDS
--
-- Анализатор подтвердил:
--   PlayerGui.ScreenGui.Menus.PlaytimeRewards.Container.Main.ScrollingFrame
-- Каждая награда = ImageButton с именем "1".."12".
-- Внутри:
--   Container.Timer
--   Container.Claim.TextLabel  ("CLAIM" / "CLAIMED")
--
-- Ручной клик по самой карточке успешно меняет CLAIM -> CLAIMED.
-- Поэтому мы не пытаемся нажимать внутренний TextLabel.
-- =========================================================

local playtimeLastAttempt = {}
local playtimeClaimedCount = 0

local function getPlaytimeScrollingFrame()
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    local menus = screenGui and screenGui:FindFirstChild("Menus")
    local playtime = menus and menus:FindFirstChild("PlaytimeRewards")
    local container = playtime and playtime:FindFirstChild("Container")
    local mainFrame = container and container:FindFirstChild("Main")
    local scrolling = mainFrame and mainFrame:FindFirstChild("ScrollingFrame")

    if scrolling and scrolling:IsA("ScrollingFrame") then
        return scrolling
    end

    return nil
end

local function getPlaytimeCardState(card)
    if not card or not card.Parent or not card:IsA("GuiButton") then
        return nil
    end

    local container = card:FindFirstChild("Container")
    local timer = container and container:FindFirstChild("Timer")
    local claim = container and container:FindFirstChild("Claim")
    local claimLabel = claim and claim:FindFirstChild("TextLabel")

    local timerText = timer and tostring(timer.Text or "") or ""
    local claimText = claimLabel and string.upper(tostring(claimLabel.Text or "")) or ""

    local minutes, seconds = timerText:match("^%s*(%d+):(%d%d)%s*$")
    local remaining = nil

    if minutes and seconds then
        remaining = tonumber(minutes) * 60 + tonumber(seconds)
    end

    return {
        timer = timer,
        timerText = timerText,
        remaining = remaining,
        claimLabel = claimLabel,
        claimText = claimText,
    }
end

local function playtimeCardIsReady(card)
    local info = getPlaytimeCardState(card)
    if not info then return false, nil end

    -- В логе ручной успешный клик был на 00:01 + CLAIM.
    -- Поэтому пытаемся забирать при 00:01 / 00:00.
    local ready =
        info.claimText == "CLAIM"
        and info.remaining ~= nil
        and info.remaining <= 1

    return ready, info
end

local function physicalPlaytimeCardClick(card)
    if not card or not card.Parent then return false end

    -- Физический fallback работает только когда окно действительно видно.
    local cur = card
    while cur and cur ~= playerGui do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        end
        if cur:IsA("ScreenGui") and not cur.Enabled then
            return false
        end
        cur = cur.Parent
    end

    local x = math.floor(card.AbsolutePosition.X + card.AbsoluteSize.X * 0.5)
    local y = math.floor(card.AbsolutePosition.Y + card.AbsoluteSize.Y * 0.5)

    return pcall(function()
        VirtualInputManager:SendMouseMoveEvent(x, y, game)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.07)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function triggerPlaytimeCard(card)
    if not card or not card.Parent then
        return false, "CARD_MISSING"
    end

    local before = getPlaytimeCardState(card)
    if not before or before.claimText ~= "CLAIM" then
        return false, "NOT_CLAIM"
    end

    -- 1) Сначала точное событие самой карточки.
    if type(firesignal) == "function" then
        pcall(function()
            firesignal(card.MouseButton1Click)
        end)

        task.wait(0.10)

        local after = getPlaytimeCardState(card)
        if after and after.claimText == "CLAIMED" then
            return true, "MouseButton1Click"
        end

        pcall(function()
            firesignal(card.Activated)
        end)

        task.wait(0.10)

        after = getPlaytimeCardState(card)
        if after and after.claimText == "CLAIMED" then
            return true, "Activated"
        end
    end

    -- 2) Если окно открыто, пробуем обычный виртуальный клик.
    physicalPlaytimeCardClick(card)
    task.wait(0.12)

    local after = getPlaytimeCardState(card)
    if after and after.claimText == "CLAIMED" then
        return true, "VirtualInput"
    end

    return false, "NO_CONFIRM"
end

local function collectReadyPlaytimeRewards()
