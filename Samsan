local function redrawLanguage()
    staticLabels.language.Text = tr("language")
    staticLabels.mode.Text = tr("mode")
    staticLabels.auto_buy.Text = tr("auto_buy")
    staticLabels.auto_sell.Text = tr("auto_sell")
    staticLabels.vip_keep.Text = tr("vip_keep")
    keepTitle.Text = tr("keep_title")
    languageButton.Text = LANGUAGE
    modeButton.Text = currentModeName() .. " • YouTube - Arc2play"

    for key in pairs(rarityButtons) do
        drawRarityCheckbox(key)
    end
    for _, draw in ipairs(toggleDrawers) do draw() end
    refreshEventStatus()
end

languageButton.MouseButton1Click:Connect(function()
    LANGUAGE = LANGUAGE == "RU" and "EN" or "RU"
    redrawLanguage()
end)

modeButton.MouseButton1Click:Connect(function()
    if #EVENT_MODES > 0 then
        selectedModeIndex = selectedModeIndex % #EVENT_MODES + 1
        lastBuyAttempt = -math.huge
        redrawLanguage()
        if AUTO_EVENT then
            task.spawn(function()
                requestEventState()
                task.wait(0.25)
                tryBuyEvent(true)
            end)
        end
    end
end)

