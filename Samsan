--
-- Никаких ожиданий телепорта игры и вложенных циклов.
-- Пока "АВТОФАРМ МАРШРУТ" = ВКЛ, маршрут бесконечный.
-- ---------------------------------------------------------

local routeIndex = 1
local routeStarted = false

local function hardTeleport(pos)
    local root = getRoot()

    if not root or typeof(pos) ~= "Vector3" then
        return false
    end

    local ok = pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        -- Два присваивания помогают, если физика в этот же кадр
        -- пытается вернуть персонажа назад.
        root.CFrame = CFrame.new(pos)
        task.wait()
        root.CFrame = CFrame.new(pos)
    end)

    return ok
end

local function holdPosition(pos, seconds, titleText)
    local duration =
        math.max(
            0.05,
            tonumber(seconds) or 0.05
        )

    local finishAt = os.clock() + duration

    while alive
        and state.routeFarm
        and os.clock() < finishAt
    do
        local root = getRoot()

        if root then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(pos)
            end)
        end

        setFarmStatus(
            string.format(
                "%s // %.1f сек",
                titleText,
                math.max(0, finishAt - os.clock())
            )
        )

        task.wait(0.06)
    end
end

local function goHome()
    syncStartFromBox()

    setFarmStatus("TP ДОМОЙ...")

    hardTeleport(routeStart)

    -- Коротко удерживаем дома, чтобы сервер принял позицию.
    holdPosition(
        routeStart,
        0.60,
        "ДОМА"
    )

    return state.routeFarm
end

local function processCurrentPoint()
    if #routePoints == 0 then
        setFarmStatus("Нет точек")
        state.routeFarm = false
        return
    end

    if routeIndex < 1 or routeIndex > #routePoints then
        routeIndex = 1
    end

    local data = routePoints[routeIndex]

    if not data then
        routeIndex = 1
        return
    end

    if data.isChest then
        setFarmStatus(
            "13 СУНДУК // TP..."
        )

        hardTeleport(data.pos)

        -- Ждём, чтобы сундук успел реально засчитаться.
        holdPosition(
            data.pos,
            data.wait,
            "СУНДУК // забираем"
        )

        if not state.routeFarm then
            return
        end

        -- Главное действие:
        -- СРАЗУ после сундука возвращаемся ДОМОЙ.
        setFarmStatus(
            "СУНДУК ЗАБРАН ✓ // ДОМОЙ"
        )

        if not goHome() then
            return
        end

        -- Новый круг ВСЕГДА начинается с первой точки.
        routeIndex = 1

        setFarmStatus(
            "НОВЫЙ КРУГ ✓ // точка 1"
        )

        task.wait(0.12)
        return
    end

    setFarmStatus(
        "ТОЧКА " ..
        tostring(routeIndex) ..
        "/" ..
        tostring(#routePoints)
    )

    hardTeleport(data.pos)

    holdPosition(
        data.pos,
        data.wait,
        "ТОЧКА " .. tostring(routeIndex)
    )

    if state.routeFarm then
        routeIndex += 1

        if routeIndex > #routePoints then
            -- На случай если сундук удалён:
            -- всё равно возвращаемся домой и начинаем заново.
            goHome()
            routeIndex = 1
        end
    end
end

task.spawn(function()
    while alive do
        if not state.routeFarm then
            routeStarted = false
            routeIndex = 1
            task.wait(0.10)
            continue
        end

        if #routePoints == 0 then
            state.routeFarm = false
            setFarmStatus("Нет точек в маршруте")
            task.wait(0.20)
            continue
        end

        if not routeStarted then
            routeStarted = true
            routeIndex = 1

            setFarmStatus(
                "ЗАПУСК // TP ДОМОЙ"
            )

            if not goHome() then
                routeStarted = false
                continue
            end

            setFarmStatus(
                "СТАРТ ✓ // точка 1"
            )

            task.wait(0.12)
        end

        -- Одна точка за итерацию.
        -- После сундука processCurrentPoint()
        -- сам ставит routeIndex обратно в 1.
        processCurrentPoint()

        task.wait(0.03)
    end
end)

-- =========================================================
-- COORDINATES
-- =========================================================

local function coordinateStrings()
    local root = getRoot()

    if not root then
        return "X 0.00   Y 0.00   Z 0.00",
               "0.00, 0.00, 0.00"
    end

    local p = root.Position

    return string.format(
        "X %.2f   Y %.2f   Z %.2f",
        p.X,
        p.Y,
        p.Z
    ),
    string.format(
        "%.2f, %.2f, %.2f",
        p.X,
        p.Y,
        p.Z
    )
end

addConnection(copyBtn.MouseButton1Click:Connect(function()
    local _, raw = coordinateStrings()

    local copied = false

    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, raw)
    elseif type(toclipboard) == "function" then
        copied = pcall(toclipboard, raw)
    end

    if not copied then
        print("[CYBER PANEL] COORDS:", raw)
    end

    copyBtn.Text = copied and "ГОТОВО" or "В КОНСОЛИ"

    task.delay(0.7, function()
        if copyBtn and copyBtn.Parent then
            copyBtn.Text = "КОПИЯ"
        end
    end)
end))

-- =========================================================
-- NOCLIP
-- =========================================================

addConnection(RunService.Stepped:Connect(function()
    if not alive or not state.noclip then
        return
    end

    local char = getCharacter()
    if not char then
        return
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originalCollisions[obj] == nil then
                originalCollisions[obj] = obj.CanCollide
            end

            obj.CanCollide = false
        end
    end
end))

-- =========================================================
-- SPEED ENFORCER
-- =========================================================

addConnection(RunService.Heartbeat:Connect(function()
    if not alive or not state.speed then
        return
    end

    local humanoid = getHumanoid()

    if humanoid
        and humanoid.WalkSpeed ~= state.speedValue
    then
        humanoid.WalkSpeed = state.speedValue
    end
end))

-- =========================================================
-- FLY
-- =========================================================

local flyKeys = {
    W = false,
    A = false,
    S = false,
    D = false,
    UP = false,
    DOWN = false,
}

local keyMap = {
    [Enum.KeyCode.W] = "W",
    [Enum.KeyCode.A] = "A",
    [Enum.KeyCode.S] = "S",
    [Enum.KeyCode.D] = "D",
    [Enum.KeyCode.Space] = "UP",
    [Enum.KeyCode.LeftControl] = "DOWN",
    [Enum.KeyCode.RightControl] = "DOWN",
}

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    local key = keyMap[input.KeyCode]

    if key then
        flyKeys[key] = true
    end
end))

addConnection(UserInputService.InputEnded:Connect(function(input)
    local key = keyMap[input.KeyCode]

    if key then
        flyKeys[key] = false
    end
end))

addConnection(RunService.RenderStepped:Connect(function()
    if not alive then
        return
    end

    local display = coordinateStrings()
    coordsLabel.Text = display

    if not state.fly then
        return
    end

    camera = workspace.CurrentCamera or camera

    local root = getRoot()
    local humanoid = getHumanoid()

    if not root or not humanoid or not camera then
        return
    end

    humanoid.PlatformStand = true

    local direction = Vector3.zero
    local cf = camera.CFrame

    if flyKeys.W then
        direction += cf.LookVector
    end

    if flyKeys.S then
        direction -= cf.LookVector
    end

    if flyKeys.D then
        direction += cf.RightVector
    end

    if flyKeys.A then
        direction -= cf.RightVector
    end

    if flyKeys.UP then
        direction += Vector3.yAxis
    end

    if flyKeys.DOWN then
        direction -= Vector3.yAxis
    end

    if direction.Magnitude > 0 then
        direction = direction.Unit
    end

    root.AssemblyLinearVelocity =
        direction * state.flySpeed

    root.AssemblyAngularVelocity = Vector3.zero
end))

-- =========================================================
-- INFINITE JUMP
-- =========================================================

addConnection(UserInputService.JumpRequest:Connect(function()
    if not alive or not state.infiniteJump then
        return
    end

    local humanoid = getHumanoid()

    if humanoid then
        humanoid:ChangeState(
            Enum.HumanoidStateType.Jumping
        )
    end
end))

-- =========================================================
-- RESPAWN
-- =========================================================

addConnection(player.CharacterAdded:Connect(function(char)
    originalWalkSpeed = nil
    table.clear(originalCollisions)

    local humanoid =
        char:WaitForChild("Humanoid", 10)

    task.wait(0.15)

    if state.speed and humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = state.speedValue
    end

    if state.fly and humanoid then
        humanoid.PlatformStand = true
    end
end))

-- =========================================================
-- DRAG HEADER
-- =========================================================

do
    local dragging = false
    local dragStart = nil
    local startPos = nil

    addConnection(main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            local localY =
                input.Position.Y -
                main.AbsolutePosition.Y

            if localY <= 48 then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end
    end))

    addConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta =
                input.Position - dragStart

            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end))

    addConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = false
        end
    end))
end

-- =========================================================
-- SHUTDOWN
-- =========================================================

local function shutdown()
    if not alive then
        return
    end

    alive = false

    state.speed = false
    state.noclip = false
    state.fly = false
    state.autoClick = false
    state.infiniteJump = false
    state.autoRebirth = false
    state.antiAfk = false
    state.routeFarm = false
    routeIndex = 1
    routeStarted = false
    restoreIdleConnections()

    local humanoid = getHumanoid()
    local root = getRoot()

    if humanoid then
        if originalWalkSpeed ~= nil then
            pcall(function()
                humanoid.WalkSpeed =
                    originalWalkSpeed
            end)
        end

        pcall(function()
            humanoid.PlatformStand = false
        end)
    end

    if root then
        pcall(function()
            root.AssemblyLinearVelocity =
                Vector3.zero

            root.AssemblyAngularVelocity =
                Vector3.zero
        end)
    end

    for part, oldValue in pairs(originalCollisions) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = oldValue
            end)
        end
    end

    for _, conn in ipairs(connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end

    if gui then
        gui:Destroy()
    end
end

addConnection(
    closeBtn.MouseButton1Click:Connect(shutdown)
)

