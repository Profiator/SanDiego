-- =========================================================
-- FLOORS // AUTO TOKENS2X x2
-- Найден анализатором:
-- PlayerGui.ScreenGui.Menus.Inventory.Container.Main.Boosts.ScrollingFrame.Owned.tokens2x
--
-- Один обычный буст рассчитан на 300 сек.
-- Два подряд = 600 сек локального ожидаемого времени.
-- Скрипт подтверждает применение по уменьшению количества xN, когда это возможно.
-- =========================================================

local TOKENS2X_KEY = "tokens2x"
local TOKENS2X_USES_PER_BATCH = 2
local TOKENS2X_SECONDS_PER_USE = 300
local TOKENS2X_BATCH_SECONDS = TOKENS2X_USES_PER_BATCH * TOKENS2X_SECONDS_PER_USE

local tokens2xNextRefreshAt = 0
local tokens2xBusy = false
local tokens2xBatchesUsed = 0

local function getTokens2xButton()
    local screenGui = playerGui:FindFirstChild("ScreenGui")
    local menus = screenGui and screenGui:FindFirstChild("Menus")
    local inventory = menus and menus:FindFirstChild("Inventory")
    local container = inventory and inventory:FindFirstChild("Container")
    local mainFrame = container and container:FindFirstChild("Main")
    local boosts = mainFrame and mainFrame:FindFirstChild("Boosts")
    local scroll = boosts and boosts:FindFirstChild("ScrollingFrame")
    local owned = scroll and scroll:FindFirstChild("Owned")
    local button = owned and owned:FindFirstChild(TOKENS2X_KEY)

    if button and button:IsA("GuiButton") then
        return button
    end

    return nil
end

local function getTokens2xQuantity(button)
    if not button or not button.Parent then return nil end

    local best = nil
    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local raw = tostring(obj.Text or "")
            local n = raw:match("[xX]%s*(%d+)")
            if n then
                n = tonumber(n)
                if n and (not best or n > best) then
                    best = n
                end
            end
        end
    end

    return best
end

local function waitTokens2xQuantityDrop(button, before, timeout)
    if not before then
        task.wait(0.20)
        return nil
    end

    local deadline = os.clock() + (tonumber(timeout) or 0.8)
    while alive and state.routeFarm and farmMode == "FLOORS" do
        local after = getTokens2xQuantity(button)
        if after and after < before then
            return after
        end
        if os.clock() >= deadline then break end
        task.wait(0.05)
    end

    return getTokens2xQuantity(button)
end

local function signalOneTokens2x(button)
    if not button or not button.Parent then return false, "BUTTON_MISSING" end

    local before = getTokens2xQuantity(button)

    -- 1) Точный обработчик той кнопки, которую пользователь нажимал вручную.
    if type(firesignal) == "function" then
        local okClick = pcall(function()
            firesignal(button.MouseButton1Click)
        end)

        if okClick then
            local after = waitTokens2xQuantityDrop(button, before, 0.75)
            if not before or (after and after < before) then
                return true, "MouseButton1Click", before, after
            end
        end

        local beforeActivated = getTokens2xQuantity(button)
        local okActivated = pcall(function()
            firesignal(button.Activated)
        end)

        if okActivated then
            local after = waitTokens2xQuantityDrop(button, beforeActivated, 0.75)
            if not beforeActivated or (after and after < beforeActivated) then
                return true, "Activated", beforeActivated, after
            end
        end
    end

    -- 2) Fallback: нормальный игровой remote, если он существует.
    if UseBoost and UseBoost:IsA("RemoteEvent") then
        local beforeRemote = getTokens2xQuantity(button)
        local okRemote = pcall(function()
            UseBoost:FireServer(TOKENS2X_KEY)
        end)

        if okRemote then
            local after = waitTokens2xQuantityDrop(button, beforeRemote, 0.90)
            if not beforeRemote or (after and after < beforeRemote) then
                return true, "UseBoost", beforeRemote, after
            end
        end
    end

    return false, "NO_CONFIRM", before, getTokens2xQuantity(button)
end

local function activateTokens2xBatch()
    if tokens2xBusy then return false end
    tokens2xBusy = true

    local okResult = false

    local ok, err = xpcall(function()
        local button = getTokens2xButton()
        if not button then
            error("tokens2x не найден в Inventory/Boosts/Owned")
        end

        local available = getTokens2xQuantity(button)
        if available and available < TOKENS2X_USES_PER_BATCH then
            error("tokens2x осталось меньше 2 // x" .. tostring(available))
        end

        setFarmStatus("ЭТАЖИ // TOKENS2X // активируем 1/2")

        local ok1, method1, before1, after1 = signalOneTokens2x(button)
        if not ok1 then
            error("tokens2x 1/2 не подтверждён // " .. tostring(method1))
        end

        task.wait(0.25)

        -- GUI может перестроить кнопку после первого использования.
        button = getTokens2xButton() or button

        setFarmStatus("ЭТАЖИ // TOKENS2X // активируем 2/2")

        local ok2, method2, before2, after2 = signalOneTokens2x(button)
        if not ok2 then
            error("tokens2x 2/2 не подтверждён // " .. tostring(method2))
        end

        tokens2xNextRefreshAt = os.clock() + TOKENS2X_BATCH_SECONDS
        tokens2xBatchesUsed += 1
        okResult = true

        local qty = getTokens2xQuantity(button)
        setFarmStatus(string.format(
            "ЭТАЖИ // TOKENS2X ×2 ✓ // осталось %s // обновление через 10:00",
            qty and ("x" .. tostring(qty)) or "?"
        ))
    end, function(message)
        return tostring(message)
    end)

    tokens2xBusy = false

    if not ok then
        setFarmStatus("ЭТАЖИ // TOKENS2X ERROR // " .. tostring(err):gsub("\n.*", ""))
        return false
    end

    return okResult
end

local function ensureTokens2xActive(forceFirst)
    if tokens2xBusy then return false end

    local now = os.clock()

    if forceFirst and tokens2xNextRefreshAt <= 0 then
        return activateTokens2xBatch()
    end

    if tokens2xNextRefreshAt > 0 and now >= tokens2xNextRefreshAt then
        return activateTokens2xBatch()
    end

    return true
end

local function waitForFloorLanding(timeoutSeconds)
    local startedAt = os.clock()
    local timeout = math.max(1, tonumber(timeoutSeconds) or 10)
    while alive and state.routeFarm and farmMode == "FLOORS" do
        local root = getRoot()
        local humanoid = getHumanoid()
        if root and humanoid then
            local landed = humanoid.FloorMaterial ~= Enum.Material.Air
            local verticalSpeed = math.abs(root.AssemblyLinearVelocity.Y)
            if landed and verticalSpeed < 6 then
                root.AssemblyAngularVelocity = Vector3.zero
                return true
            end
            setFarmStatus(string.format(
                "ЭТАЖИ // опускаемся... Y %.1f // %.1f сек",
                root.Position.Y,
                os.clock() - startedAt
            ))
        end
        if os.clock() - startedAt >= timeout then
            return false
        end
        task.wait(0.08)
    end
    return false
end

local function holdFloorSpot(minutes)
    -- V34: во время таймера НЕ фиксируем CFrame.
    -- После TP персонаж свободно падает под действием гравитации и стоит там, где приземлился.
    local duration = math.max(3, (tonumber(minutes) or 10) * 60)
    local startedAt = os.clock()
    local nextStatusAt = 0
    while alive and state.routeFarm and farmMode == "FLOORS" do
        local elapsed = os.clock() - startedAt
        if elapsed >= duration then return true end

        local humanoid = getHumanoid()
        local root = getRoot()
        if not humanoid or not root or humanoid.Health <= 0 then
            return false
        end

        -- TOKENS2X поддерживаем непрерывно во время нахождения на этажах.
        if tokens2xNextRefreshAt > 0 and os.clock() >= tokens2xNextRefreshAt and not tokens2xBusy then
            activateTokens2xBatch()
        end

        if elapsed >= nextStatusAt then
            nextStatusAt = elapsed + 0.5
            local remaining = math.max(0, duration - elapsed)
            local m = math.floor(remaining / 60)
            local sec = math.floor(remaining % 60)

            local boostText = ""
            if tokens2xNextRefreshAt > 0 then
                local boostLeft = math.max(0, tokens2xNextRefreshAt - os.clock())
                local bm = math.floor(boostLeft / 60)
                local bs = math.floor(boostLeft % 60)
                boostText = string.format(" // TOKENS2X %02d:%02d", bm, bs)
            end

            setFarmStatus(string.format(
                "ЭТАЖИ // ожидание %02d:%02d // Y %.1f // круг #%d%s",
                m, sec, root.Position.Y, floorCycleCount + 1, boostText
            ))
        end
        task.wait(0.10)
    end
    return false
end

local function killForFloorCycle()
    local char = getCharacter()
    local humanoid = getHumanoid()
    if not char or not humanoid then return nil end
    setFarmStatus("ЭТАЖИ // таймер окончен // умираем...")
    pcall(function() humanoid.Health = 0 end)
    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Dead) end)
    task.wait(0.15)
    pcall(function() char:BreakJoints() end)
    return char
end

local function waitAfterFloorDeath(seconds)
    local duration = math.max(0, tonumber(seconds) or 15)
    local startedAt = os.clock()

    while alive and state.routeFarm and farmMode == "FLOORS" do
        local elapsed = os.clock() - startedAt
        if elapsed >= duration then
            return true
        end

        local remaining = math.max(0, duration - elapsed)
        setFarmStatus(string.format(
            "ЭТАЖИ // смерть // ждём %.1f сек // новый круг через %.1f",
            duration,
            remaining
        ))

        task.wait(0.10)
    end

    return false
end

local function floorGoHome()
    local deadline = os.clock() + 12
    while alive and state.routeFarm and farmMode == "FLOORS" do
        if hardTeleport(FLOOR_HOME) then
            holdPosition(FLOOR_HOME, 0.50, "ЭТАЖИ // ДОМА")
            return true
        end
        if os.clock() >= deadline then return false end
        task.wait(0.15)
    end
    return false
end

local function runFloorCycle()
    syncFloorTimer()
    if not floorGoHome() then return false, "Не найден персонаж для дома" end
    if not state.routeFarm then return false end

    setFarmStatus("ЭТАЖИ // TP к порталу")
    if not hardTeleport(FLOOR_PORTAL) then return false, "Не удалось TP к порталу" end
    holdPosition(FLOOR_PORTAL, 0.35, "ЭТАЖИ // ПОРТАЛ")
    if not state.routeFarm then return false end

    local startButton = waitForEndlessStartButton(20)
    if not startButton then return false, "Кнопка START не появилась" end

    setFarmStatus("ЭТАЖИ // START найден ✓ // ждём 2 сек")
    if not pressStartUntilGameTeleport() then
        return false, "START/TP игры не подтверждён"
    end
    if not state.routeFarm then return false end

    -- ВАЖНО: до этого места скрипт НЕ поднимает персонажа на FLOOR_HOLD.
    -- Сначала сама игра должна перенести его с портала на Endless-арену.
    local settleStarted = os.clock()
    while alive and state.routeFarm and farmMode == "FLOORS"
        and os.clock() - settleStarted < 0.80 do
        task.wait(0.05)
    end
    if not state.routeFarm then return false end

    setFarmStatus("ЭТАЖИ // TP игры подтверждён ✓ // проверяем TOKENS2X")
    ensureTokens2xActive(true)
    if not state.routeFarm then return false end

    setFarmStatus("ЭТАЖИ // теперь TP к точке этажей")
    if not hardTeleport(FLOOR_HOLD) then return false, "Не удалось TP на этаж" end

    -- После TP больше не удерживаем Y=102.26: гравитация должна опустить персонажа на поверхность.
    local landed = waitForFloorLanding(10)
    if not landed then
        setFarmStatus("ЭТАЖИ // посадка не подтверждена // таймер всё равно запущен")
        task.wait(0.20)
    else
        setFarmStatus("ЭТАЖИ // приземлились ✓ // запускаем таймер")
        task.wait(0.15)
    end

    if not holdFloorSpot(floorDurationMinutes) or not state.routeFarm then return false end

    local oldCharacter = killForFloorCycle()
    if not oldCharacter then return false, "Не удалось получить Humanoid" end

    -- V39: после смерти ничего не нажимаем.
    -- Ждём 15 секунд, затем запускаем следующий цикл.
    if not waitAfterFloorDeath(15) then return false end
    if not state.routeFarm then return false end

    floorCycleCount += 1
    if not state.routeLoop then
        state.routeFarm = false
        setFarmToggleVisual(false)
        setFarmStatus("ЭТАЖИ ЗАВЕРШЕНЫ ✓ // один проход")
        return false
    end
    setFarmStatus("ЭТАЖИ // новый круг #" .. tostring(floorCycleCount + 1))
    task.wait(0.25)
    return true
end

task.spawn(function()
    while alive do
        if farmMode ~= "FLOORS" or not state.routeFarm then
            floorCycleRunning = false
            task.wait(0.12)
            continue
        end
        if floorCycleRunning then task.wait(0.10); continue end
        floorCycleRunning = true
        local ok, shouldContinue, err = pcall(function()
            local c, m = runFloorCycle()
            return c, m
        end)
        floorCycleRunning = false
        if not ok then
            state.routeFarm = false
            setFarmToggleVisual(false)
            setFarmStatus("ЭТАЖИ ERROR // " .. tostring(shouldContinue))
        elseif state.routeFarm and shouldContinue == false and err then
            state.routeFarm = false
            setFarmToggleVisual(false)
            setFarmStatus("ЭТАЖИ ОСТАНОВЛЕНЫ // " .. tostring(err))
        end
        task.wait(0.15)
    end
end)

