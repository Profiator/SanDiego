    for i, data in ipairs(routePoints) do
        if data.isChest then
            data.name = "СУНДУК"
        elseif not data.name or data.name == "" then
            data.name = "Локация " .. tostring(i)
        end
        makeRouteRow(i, data)
    end
    updateCanvas()
end

