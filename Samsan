-- =========================================================
-- ORIGINAL MENU CALLBACK BRIDGE
-- Старое окно загружается только как "движок":
-- 1) находим его родные кнопки;
-- 2) сохраняем их callbacks;
-- 3) сразу скрываем старое окно;
-- 4) MASTER вызывает сохранённые callbacks напрямую.
-- =========================================================

local originalCallbacks = {
    AutoFarm = {},
    EquipBest = {},
}

local originalGuiRoot = nil
local originalBound = false

local function getGuiSearchRoots()
    local roots, seen = {}, {}

    local function add(x)
        if x and not seen[x] then
            seen[x] = true
            table.insert(roots, x)
        end
    end

    add(CoreGui)
    add(player:FindFirstChildOfClass("PlayerGui"))

    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok then add(hui) end
    end

    return roots
end

local function isInsideMaster(obj)
    local p = obj
    while p do
        if p.Name == "Arc2playMasterV4" then
            return true
        end
        p = p.Parent
    end
    return false
end

local function textEquals(obj, wanted)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
        return false
    end
    return string.lower(tostring(obj.Text or "")) == string.lower(wanted)
end

local function findLabel(wanted)
    for _, root in ipairs(getGuiSearchRoots()) do
        for _, obj in ipairs(root:GetDescendants()) do
            if not isInsideMaster(obj) and textEquals(obj, wanted) then
                return obj
            end
        end
    end
    return nil
end

local function findScreenRoot(obj)
    local p = obj
    local best = obj

    while p do
        best = p
        if p:IsA("ScreenGui") then
            return p
        end
        p = p.Parent
    end

    return best
end

local function nearestButtonToLabel(label)
    if not label then return nil end
    if label:IsA("GuiButton") then return label end

    local container = label.Parent
    for _ = 1, 5 do
        if not container then break end

        local labelY = label.AbsolutePosition.Y + label.AbsoluteSize.Y / 2
        local labelRight = label.AbsolutePosition.X + label.AbsoluteSize.X
        local best, bestScore = nil, math.huge

        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("GuiButton") and not isInsideMaster(obj) then
                local cy = obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2
                local cx = obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2
                local dy = math.abs(cy - labelY)

                -- toggle old Tora UI is to the right of the label
                if dy <= 30 and cx >= labelRight - 10 then
                    local score = dy * 10 + math.abs(cx - labelRight)
                    if score < bestScore then
                        best = obj
                        bestScore = score
                    end
                end
            end
        end

        if best then return best end
        container = container.Parent
    end

    return nil
end

local function collectCallbacks(button)
    local callbacks = {}

    if not button or type(getconnections) ~= "function" then
        return callbacks
    end

    for _, signal in ipairs({
        button.MouseButton1Click,
        button.Activated,
        button.MouseButton1Down,
    }) do
        local ok, connections = pcall(getconnections, signal)

        if ok and type(connections) == "table" then
            for _, connection in ipairs(connections) do
                if type(connection.Function) == "function" then
                    table.insert(callbacks, function()
                        return pcall(connection.Function)
                    end)
                elseif type(connection.Fire) == "function" then
                    table.insert(callbacks, function()
                        return pcall(function()
                            connection:Fire()
                        end)
                    end)
                end
            end
        end
    end

    return callbacks
end

local function hideOriginalGui()
    if not originalGuiRoot or not originalGuiRoot.Parent then
        return
    end

    if originalGuiRoot:IsA("ScreenGui") then
        originalGuiRoot.Enabled = false
    elseif originalGuiRoot:IsA("GuiObject") then
        originalGuiRoot.Visible = false
    else
        for _, obj in ipairs(originalGuiRoot:GetChildren()) do
            if obj:IsA("ScreenGui") then
                obj.Enabled = false
            elseif obj:IsA("GuiObject") then
                obj.Visible = false
            end
        end
    end
end

local function bindOriginalMenu()
    if originalBound then
        hideOriginalGui()
        return true
    end

    local farmLabel = findLabel("Instant LastZone")
    local equipLabel = findLabel("Equip Best")

    if not farmLabel or not equipLabel then
        return false
    end

    local farmButton = nearestButtonToLabel(farmLabel)
    local equipButton = nearestButtonToLabel(equipLabel)

    if not farmButton or not equipButton then
        return false
    end

    local farmCallbacks = collectCallbacks(farmButton)
    local equipCallbacks = collectCallbacks(equipButton)

    if #farmCallbacks == 0 or #equipCallbacks == 0 then
        return false
    end

    originalCallbacks.AutoFarm = farmCallbacks
    originalCallbacks.EquipBest = equipCallbacks
    originalGuiRoot = findScreenRoot(farmLabel)
    originalBound = true

    -- После того как callbacks сохранены, старое окно больше не нужно показывать.
    hideOriginalGui()

    log(
        "Original callbacks bound:",
        "AutoFarm =", #farmCallbacks,
        "EquipBest =", #equipCallbacks
    )

    return true
end

local function invokeOldControl(kind)
    if not originalBound then
        for _ = 1, 50 do
            if bindOriginalMenu() then
                break
            end
            task.wait(0.05)
        end
    end

    local callbacks = originalCallbacks[kind]

    if type(callbacks) ~= "table" or #callbacks == 0 then
        return false, "original callback not found"
    end

    local fired = false

    for _, callback in ipairs(callbacks) do
        local ok, result = pcall(callback)
        if ok and result ~= false then
            fired = true
        end
    end

    hideOriginalGui()

    if fired then
        return true
    end

    return false, "original callback failed"
end

