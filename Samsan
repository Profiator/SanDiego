local function movePoint(index, direction)
    if state.routeFarm then
        setFarmStatus("Останови автофарм перед изменением порядка")
        return
    end
    local data = routePoints[index]
    if not data then return end
    if data.isChest then
        setFarmStatus("Сундук нельзя двигать; удалить можно через ×")
        return
    end
    local target = index + direction
    if target < 1 or target > #routePoints then return end
    local targetData = routePoints[target]
    if targetData and targetData.isChest then
        setFarmStatus("Сундук нельзя опускать/поднимать; удалить можно через ×")
        return
    end
    routePoints[index], routePoints[target] = routePoints[target], routePoints[index]
    saveRouteLocal(true)
    rebuildRouteRows()
    setFarmStatus("Порядок изменён // " .. tostring(data.name))
end

