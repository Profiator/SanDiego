local function getCharRoot(preferVehicle)
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if preferVehicle and humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local vehicle = humanoid.SeatPart:FindFirstAncestorWhichIsA("Model")
        if vehicle and vehicle.PrimaryPart then return vehicle.PrimaryPart end
        return humanoid.SeatPart
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getCar()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            return humanoid.SeatPart:FindFirstAncestorWhichIsA("Model")
        end
    end
    return nil
end

local function teleportTo(targetPos, keepVehicle)
    local root = getCharRoot(keepVehicle)
    if root then
        _G.AllowCFrameChange = true
        root.CFrame = CFrame.new(targetPos)
        _G.AllowCFrameChange = false
    end
end

